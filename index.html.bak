<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>مافيا — أونلاين</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0a12;--surface:#121225;--surface2:#1c1c3a;--border:#2d2d50;
  --mafia:#e63946;--mafia-g:#e6394430;
  --civil:#4cc9f0;--civil-g:#4cc9f030;
  --doctor:#2dc653;--doctor-g:#2dc65330;
  --detective:#f4a261;--detective-g:#f4a26130;
  --sniper:#9d4edd;--sniper-g:#9d4edd30;
  --gold:#ffd166;--text:#ededf8;--muted:#7777a0;
  --r:14px;--rs:10px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100dvh;overflow:hidden;background:var(--bg);color:var(--text);font-family:'Cairo',sans-serif;position:fixed;
  background-image:linear-gradient(rgba(10,10,18,0.35),rgba(10,10,18,0.55)),url('wallpaper.jpeg');
  background-size:cover;background-position:center;}

.screen{position:fixed;inset:0;display:none;flex-direction:column;overflow:hidden;background:rgba(10,10,18,0.72);backdrop-filter:blur(8px);}
.screen.active{display:flex;animation:fadeIn .25s ease}
@keyframes fadeIn{from{opacity:0;transform:scale(.98)}to{opacity:1;transform:scale(1)}}
@keyframes slideUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes killAnim{0%{background:transparent}50%{background:#e6394640}100%{background:transparent}}
@keyframes protectAnim{0%{box-shadow:inset 0 0 0px #2dc653}100%{box-shadow:inset 0 0 40px #2dc653}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
@keyframes spinIn{from{opacity:0;transform:scale(.8) rotate(-5deg)}to{opacity:1;transform:scale(1) rotate(0deg)}}
@keyframes glow{0%,100%{box-shadow:0 0 20px var(--gc,#e6394650)}50%{box-shadow:0 0 40px var(--gc,#e6394650)}}

.hdr{width:100%;padding:14px 18px 12px;display:flex;align-items:center;justify-content:space-between;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0}
.hdr-title{font-size:1rem;font-weight:900;color:var(--gold)}
.hdr-back{width:36px;height:36px;border-radius:50%;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;transition:.15s}
.hdr-back:active{transform:scale(.88);background:var(--border)}

.scroll{flex:1;overflow-y:auto;padding:16px;-webkit-overflow-scrolling:touch}
.scroll::-webkit-scrollbar{display:none}
.scroll-fix{flex:1;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;padding:16px}

.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:15px;border-radius:var(--r);font-family:'Cairo',sans-serif;font-size:.95rem;font-weight:700;border:none;cursor:pointer;transition:.15s;letter-spacing:.01em}
.btn:active{transform:scale(.96)}
.btn-red{background:linear-gradient(135deg,#e63946,#b5121e);color:#fff;box-shadow:0 4px 18px #e6394450}
.btn-gold{background:linear-gradient(135deg,#ffd166,#d4940e);color:#111;box-shadow:0 4px 18px #ffd16650}
.btn-green{background:linear-gradient(135deg,#2dc653,#1a8a38);color:#fff;box-shadow:0 4px 18px #2dc65350}
.btn-gray{background:var(--surface2);border:1px solid var(--border);color:var(--text)}
.btn-ghost{background:transparent;border:1px solid var(--border);color:var(--muted)}
.btn-sm{padding:10px 14px;font-size:.84rem;border-radius:var(--rs)}
.btn-purple{background:linear-gradient(135deg,#9d4edd,#6a1fa0);color:#fff;box-shadow:0 4px 18px #9d4edd50}
.btn-blue{background:linear-gradient(135deg,#4cc9f0,#1a7a9a);color:#111;box-shadow:0 4px 18px #4cc9f050}

.lbl{font-size:.75rem;color:var(--muted);margin-bottom:5px;padding-right:2px}
input,select{width:100%;padding:13px 15px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);color:var(--text);font-family:'Cairo',sans-serif;font-size:.95rem;outline:none;transition:.2s}
input:focus,select:focus{border-color:var(--gold);box-shadow:0 0 0 3px #ffd16618}
select option{background:var(--surface2)}

.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:15px;margin-bottom:12px;box-shadow:0 4px 15px rgba(0,0,0,0.2)}
.stitle{font-size:.72rem;font-weight:700;letter-spacing:.12em;color:var(--gold);text-transform:uppercase;margin-bottom:10px}

.trow{display:flex;align-items:center;justify-content:space-between;padding:11px 0}
.tog{position:relative;width:46px;height:25px;background:var(--border);border-radius:13px;cursor:pointer;transition:.3s;flex-shrink:0}
.tog.on{background:var(--doctor)}
.tog::after{content:'';position:absolute;top:3px;right:3px;width:19px;height:19px;background:#fff;border-radius:50%;transition:.3s}
.tog.on::after{right:auto;left:3px}

.pills{display:flex;gap:6px;flex-wrap:wrap}
.pill{padding:7px 13px;border-radius:99px;background:var(--surface2);border:1px solid var(--border);font-size:.8rem;cursor:pointer;transition:.15s;font-family:'Cairo',sans-serif}
.pill.on{background:linear-gradient(135deg,#ffd166,#d4940e);color:#111;border-color:transparent;font-weight:700}

hr{border:none;border-top:1px solid var(--border);margin:14px 0}
.badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:99px;font-size:.72rem;font-weight:700}

/* ============ LANDING ============ */
#s-land{justify-content:center;align-items:center;}
.land-bg{position:absolute;inset:0;pointer-events:none;background:linear-gradient(rgba(10,10,18,0.3),rgba(10,10,18,0.5))}
.land-inner{z-index:1;text-align:center;padding:24px 22px;width:100%;max-width:380px}
.logo{width:88px;height:88px;border-radius:20px;border:2px solid #e63946;background:linear-gradient(135deg,#1c0008,#2d0012);display:flex;align-items:center;justify-content:center;font-size:2.4rem;margin:0 auto 16px;--gc:#e6394650;animation:glow 2.8s ease-in-out infinite}
.land-title{font-size:2rem;font-weight:900;background:linear-gradient(135deg,#fff 20%,#ffd166 60%,#e63946);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1.1;margin-bottom:4px}
.land-sub{color:var(--muted);font-size:.85rem;margin-bottom:24px}
.land-btns{display:flex;flex-direction:column;gap:9px;max-width:300px;margin:0 auto}

/* ============ LOBBY ============ */
.room-header{background:var(--surface);border-bottom:1px solid var(--border);padding:12px 16px;flex-shrink:0}
.room-code{font-size:1.8rem;font-weight:900;letter-spacing:.2em;color:var(--gold);text-align:center}
.room-code-lbl{font-size:.72rem;color:var(--muted);text-align:center;margin-bottom:4px}
.player-lobby-card{display:flex;align-items:center;gap:10px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);padding:11px 14px;margin-bottom:7px;animation:slideUp .2s ease}
.player-lobby-card.host-p{border-color:var(--gold)}
.host-crown{font-size:.75rem;background:var(--gold);color:#111;padding:2px 7px;border-radius:99px;font-weight:900}

/* ============ PLAYERS LIST ============ */
.p-item{display:flex;align-items:center;gap:10px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);padding:11px 13px;margin-bottom:7px;animation:slideUp .2s ease}
.p-ava{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.95rem;flex-shrink:0}
.p-name{flex:1;font-size:.92rem;font-weight:600}
.p-del{width:28px;height:28px;border-radius:50%;background:transparent;border:1px solid var(--border);color:var(--muted);cursor:pointer;font-size:.75rem;display:flex;align-items:center;justify-content:center;transition:.15s}
.p-del:active{background:var(--mafia);color:#fff;border-color:var(--mafia)}

/* ============ ROLES GRID ============ */
.rgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.rcrd{background:var(--surface2);border:2px solid var(--border);border-radius:var(--rs);padding:12px 8px;text-align:center;position:relative;overflow:hidden;transition:.2s}
.rcrd.on{border-color:var(--rc,#fff)}
.rcrd.on::before{content:'';position:absolute;inset:0;background:var(--rg,#fff1);pointer-events:none}
.rcrd-icon{font-size:1.5rem;margin-bottom:3px}
.rcrd-name{font-size:.8rem;font-weight:700}
.rcrd-cnt{position:absolute;top:5px;left:5px;width:19px;height:19px;border-radius:50%;background:var(--rc,#fff);color:#111;font-size:.68rem;font-weight:900;display:flex;align-items:center;justify-content:center}
.ccrow{display:flex;align-items:center;gap:7px;justify-content:center;margin-top:6px}
.ccbtn{width:22px;height:22px;border-radius:50%;background:var(--surface);border:1px solid var(--border);color:var(--text);font-size:.95rem;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;transition:.15s}
.ccbtn:active{background:var(--gold);color:#111;border-color:var(--gold)}
.ccval{font-weight:900;font-size:.88rem;min-width:18px;text-align:center}

/* ============ PASS PHONE ============ */
#s-pass{justify-content:center;align-items:center;background:radial-gradient(ellipse at 50% 40%,#0d0025,var(--bg) 70%)}
.pass-inner{text-align:center;padding:24px 22px;width:100%}
.pass-icon{font-size:3.8rem;margin-bottom:14px}
.pass-title{font-size:1.35rem;font-weight:900;color:var(--gold);margin-bottom:6px}
.pass-sub{font-size:.9rem;color:var(--muted);margin-bottom:26px;line-height:1.7}

/* ============ ROLE REVEAL ============ */
#s-role{justify-content:center;align-items:center;background:radial-gradient(ellipse at 50% 30%,#0d0020,var(--bg) 70%)}
.reveal-wrap{width:100%;max-width:340px;padding:20px;text-align:center;animation:spinIn .35s ease}
.reveal-who{font-size:1rem;color:var(--text);margin-bottom:18px;font-weight:700}
.big-card{border-radius:22px;padding:32px 20px 26px;position:relative;overflow:hidden;border:2px solid var(--rc,#fff);background:linear-gradient(160deg,var(--surface2),var(--bg));box-shadow:0 0 60px var(--rg,#0000);margin-bottom:18px}
.big-card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,var(--rg,#0000),transparent 65%)}
.big-img{position:absolute;inset:0;opacity:0.15;background-size:contain;background-position:center;background-repeat:no-repeat;pointer-events:none;filter:drop-shadow(0 0 20px var(--rc,#fff))}
.big-team{position:absolute;top:11px;right:11px;padding:4px 12px;border-radius:99px;font-size:.8rem;font-weight:700}
.big-icon{font-size:5rem;position:relative;margin-bottom:12px}
.big-name{font-size:2.6rem;font-weight:900;position:relative;margin-bottom:10px}
.big-desc{font-size:1rem;color:var(--text);line-height:1.75;position:relative;opacity:.85}
.tap-ov{position:absolute;inset:0;background:var(--surface2);border-radius:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;cursor:pointer;z-index:10;transition:.3s}
.tap-ov.gone{opacity:0;pointer-events:none}

/* ============ WAITING ONLINE ============ */
#s-wait{justify-content:center;align-items:center;background:radial-gradient(ellipse at 50% 30%,#0a0020,var(--bg) 70%)}
.wait-inner{text-align:center;padding:24px;width:100%}
.wait-spin{font-size:3rem;animation:pulse 1s infinite}

/* ============ NIGHT ============ */
#s-night{background:radial-gradient(ellipse at 50% 0%,#06011a,#030310 80%)}
.night-top{width:100%;background:var(--surface);border-bottom:1px solid var(--border);padding:9px 18px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.rnd-pill{padding:4px 11px;border-radius:99px;background:var(--surface2);font-size:.78rem;font-weight:700;border:1px solid var(--border)}
.phase-lbl{font-size:.78rem;font-weight:700;color:var(--gold)}
.q-bar{display:flex;gap:6px;padding:10px 16px 6px;overflow-x:auto;flex-shrink:0}
.q-bar::-webkit-scrollbar{display:none}
.night-hdr{text-align:center;padding:14px 16px 10px;flex-shrink:0}
.night-emo{font-size:2.2rem;margin-bottom:3px}
.night-rlbl{font-size:1.15rem;font-weight:900}
.night-hint{font-size:.8rem;color:var(--muted);margin-top:2px}
.pick-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding:0 14px;overflow-y:auto;flex:1}
.pick-card{background:var(--surface2);border:2px solid var(--border);border-radius:var(--r);padding:15px 8px;text-align:center;cursor:pointer;transition:.18s;position:relative;overflow:hidden;}
.pick-card:active{transform:scale(.95)}
.pick-card.on{border-color:var(--rc,#fff);box-shadow:0 0 18px var(--rg,#0000)}
.pick-card.dead{opacity:.28;pointer-events:none;filter:grayscale(1)}
.pick-ava{width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.15rem;font-weight:900;margin:0 auto 7px}
.pick-nm{font-size:.82rem;font-weight:700}
.pick-tick{position:absolute;top:6px;left:6px;width:20px;height:20px;border-radius:50%;background:var(--rc,#fff);color:#111;font-size:.7rem;display:none;align-items:center;justify-content:center;font-weight:900}
.pick-card.on .pick-tick{display:flex}
.mafia-team-badge{position:absolute;bottom:5px;right:5px;font-size:.6rem;background:var(--mafia);color:#fff;padding:2px 5px;border-radius:4px;font-weight:bold}
.night-footer{padding:10px 14px 18px;display:flex;flex-direction:column;gap:7px;flex-shrink:0}

/* ============ ONLINE NIGHT ============ */
#s-night-online{background:radial-gradient(ellipse at 50% 0%,#06011a,#030310 80%)}
.online-night-status{text-align:center;padding:20px;font-size:.9rem;color:var(--muted)}

/* ============ NIGHT RESULT ============ */
#s-nresult{background:var(--bg)}
.nr-card{margin:0;padding:16px;border-radius:var(--r);border:1px solid var(--border);text-align:center}
.nr-icon{font-size:2rem;margin-bottom:5px}
.nr-title{font-size:.97rem;font-weight:700}
.nr-sub{font-size:.8rem;color:var(--muted)}
.stat-row{display:flex;gap:8px}
.stat-b{flex:1;background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);padding:10px 6px;text-align:center}
.stat-n{font-size:1.25rem;font-weight:900;color:var(--gold)}
.stat-l{font-size:.68rem;color:var(--muted);margin-top:1px}

/* ============ DAY ============ */
#s-day{background:radial-gradient(ellipse at 50% 0%,#120f04,#060609 70%)}
.day-list{overflow-y:auto;flex:1;padding:10px 14px 0}
.day-row{display:flex;align-items:center;gap:11px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);padding:11px 13px;margin-bottom:7px;transition:.2s}
.day-row.dead{opacity:.3;pointer-events:none;filter:grayscale(1)}
.day-row.hi{border-color:var(--mafia);background:#e6394410}
.vcnt{width:26px;height:26px;border-radius:50%;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.82rem;transition:.3s}
.vcnt.vv{background:var(--mafia);border-color:var(--mafia);color:#fff}
.vbtn{padding:6px 13px;border-radius:99px;font-size:.76rem;font-weight:700;background:var(--surface);border:1px solid var(--border);color:var(--muted);cursor:pointer;transition:.18s;font-family:'Cairo',sans-serif}
.vbtn.on{background:var(--mafia);color:#fff;border-color:var(--mafia)}
.tbar-wrap{margin:6px 14px 0;background:var(--surface2);border-radius:99px;height:5px;overflow:hidden;flex-shrink:0}
.tbar{height:100%;border-radius:99px;background:linear-gradient(90deg,#ffd166,#e63946);transition:width 1s linear}
.ttxt{text-align:center;font-size:.78rem;color:var(--muted);padding:4px 0 0;flex-shrink:0}
.day-footer{padding:10px 14px 16px;display:flex;flex-direction:column;gap:7px;flex-shrink:0}

/* VOTE PASS SCREEN */
#s-vpass{justify-content:center;align-items:center;background:var(--surface)}
.vpass-inner{text-align:center;padding:24px 22px;width:100%}

/* ============ RESULT ============ */
#s-result{justify-content:center;align-items:center;background:var(--bg)}
.res-wrap{text-align:center;padding:20px;width:100%;overflow-y:auto;max-height:100%}
.res-icon{font-size:5rem;margin-bottom:10px;animation:pulse 1.4s ease-in-out infinite}
.res-title{font-size:1.9rem;font-weight:900;margin-bottom:6px}
.res-sub{color:var(--muted);font-size:.88rem;margin-bottom:22px}
.roles-reveal-list{text-align:right;margin-bottom:20px}
.rrl-row{display:flex;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid var(--border)}

/* ============ RULES ============ */
#s-rules{background:var(--bg)}

/* ============ MODAL ============ */
.modal-bg{position:fixed;inset:0;background:#00000085;z-index:100;display:none;align-items:flex-end}
.modal-bg.show{display:flex;animation:fadeIn .2s ease}
.modal-sheet{width:100%;background:var(--surface);border-radius:22px 22px 0 0;padding:22px 18px 30px;animation:slideUp .28s ease;border-top:1px solid var(--border)}
.modal-handle{width:38px;height:4px;border-radius:2px;background:var(--border);margin:0 auto 18px}
.modal-title{font-size:1.05rem;font-weight:900;margin-bottom:14px;text-align:center}

/* TOAST */
.toast{position:fixed;bottom:100px;left:50%;transform:translateX(-50%);background:var(--surface);border:1px solid var(--border);border-radius:99px;padding:9px 18px;font-size:.82rem;font-weight:600;z-index:200;pointer-events:none;opacity:0;transition:.3s;white-space:nowrap;max-width:85vw;text-align:center}
.toast.show{opacity:1}

/* CHAT */
.chat-ov{position:fixed;bottom:80px;right:16px;width:300px;height:400px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);display:none;flex-direction:column;z-index:90;box-shadow:0 10px 30px #000}
.chat-ov.open{display:flex;animation:slideUp .2s ease}
.chat-tabs{display:flex;background:var(--surface2);border-radius:var(--r) var(--r) 0 0;overflow:hidden}
.chat-tab{flex:1;padding:10px;text-align:center;font-size:.75rem;cursor:pointer;font-weight:700;color:var(--muted);transition:.2s}
.chat-tab.active{color:var(--gold);border-bottom:2px solid var(--gold)}
.chat-msgs{flex:1;overflow-y:auto;padding:10px;font-size:.82rem;display:flex;flex-direction:column;gap:6px}
.chat-msgs::-webkit-scrollbar{display:none}
.msg{padding:7px 10px;border-radius:10px;background:var(--surface2);max-width:85%;word-break:break-word;line-height:1.4}
.msg.me{align-self:flex-end;background:linear-gradient(135deg,#ffd166,#d4940e);color:#111}
.msg.mafia-msg{border-right:3px solid var(--mafia)}
.msg-sender{font-size:.7rem;font-weight:900;margin-bottom:2px;opacity:.7}
.chat-inp-wrap{padding:10px;display:flex;gap:6px;border-top:1px solid var(--border)}
.chat-inp-wrap input{padding:8px 12px}
.chat-btn{position:fixed;bottom:24px;right:20px;width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#ffd166,#d4940e);border:none;font-size:1.4rem;cursor:pointer;z-index:89;box-shadow:0 4px 16px #0008;display:none}
.chat-badge{position:absolute;top:-4px;right:-4px;width:18px;height:18px;border-radius:50%;background:var(--mafia);color:#fff;font-size:.65rem;font-weight:900;display:none;align-items:center;justify-content:center}
.chat-badge.show{display:flex}

/* UTILS */
.fc{display:flex;align-items:center}
.gap8{gap:8px}
.mt8{margin-top:8px}
.mt12{margin-top:12px}
.tc{text-align:center}
.muted{color:var(--muted);font-size:.85rem}
.bold{font-weight:700}
.w100{width:100%}

/* AVATAR COLORS */
.av0{background:#e6394420;color:#e63946}.av1{background:#4cc9f020;color:#4cc9f0}.av2{background:#2dc65320;color:#2dc653}.av3{background:#f4a26120;color:#f4a261}.av4{background:#9d4edd20;color:#9d4edd}.av5{background:#ffd16620;color:#ffd166}.av6{background:#fb850020;color:#fb8500}.av7{background:#3a86ff20;color:#3a86ff}.av8{background:#ef233c20;color:#ef233c}.av9{background:#06d6a020;color:#06d6a0}.av10{background:#8338ec20;color:#8338ec}.av11{background:#ff006e20;color:#ff006e}

/* Connection indicator */
.conn-dot{width:8px;height:8px;border-radius:50%;background:var(--muted);display:inline-block;margin-left:6px}
.conn-dot.online{background:var(--doctor);box-shadow:0 0 6px var(--doctor)}

/* Rooms list */
.room-item{display:flex;align-items:center;gap:12px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);padding:13px 14px;margin-bottom:8px;cursor:pointer;transition:.2s}
.room-item:active{transform:scale(.97)}
.room-item .room-code-sm{font-size:1.3rem;font-weight:900;color:var(--gold);letter-spacing:.1em}
.room-item .room-info{flex:1}
.room-status{font-size:.72rem;padding:3px 9px;border-radius:99px;font-weight:700}
.room-status.waiting{background:var(--doctor);color:#111}
.room-status.playing{background:var(--mafia);color:#fff}

/* Host controls bar */
.host-bar{background:var(--surface);border-top:1px solid var(--gold);padding:10px 14px;flex-shrink:0;display:flex;gap:7px}

/* Online status overlay during night */
.online-waiting-overlay{position:absolute;inset:0;background:rgba(10,10,18,0.92);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;z-index:20}
</style>
</head>
<body>

<!-- ======== LANDING ======== -->
<div id="s-land" class="screen active">
  <div class="land-bg"></div>
  <div class="land-inner">
    <div class="logo">🎭</div>
    <div class="land-title">مافيا</div>
    <div class="land-sub">لعبة الغرف السرية — أونلاين 🌐</div>
    <div class="land-btns">
      <button class="btn btn-red" onclick="showScreen('s-online-menu')">🌐 لعب أونلاين</button>
      <button class="btn btn-gold" onclick="G.showSetup()">🎮 لعبة محلية (نفس الجهاز)</button>
      <button class="btn btn-gray" onclick="G.showRules()">📖 قواعد اللعبة</button>
    </div>
    <div style="margin-top:18px;font-size:.72rem;color:var(--muted)">إصدار 2.0 — أونلاين حقيقي</div>
  </div>
</div>

<!-- ======== ONLINE MENU ======== -->
<div id="s-online-menu" class="screen">
  <div class="hdr">
    <div class="hdr-back" onclick="showScreen('s-land')">←</div>
    <div class="hdr-title">🌐 اللعب الأونلاين</div>
    <div style="width:36px;text-align:center"><span class="conn-dot" id="conn-dot"></span></div>
  </div>
  <div class="scroll-fix">
    <div class="card">
      <div class="lbl">👤 اسمك في اللعبة</div>
      <input id="online-name" type="text" placeholder="أدخل اسمك..." maxlength="14">
    </div>
    <div style="display:flex;gap:8px;margin-bottom:12px">
      <button class="btn btn-gold" onclick="OL.createRoom()" style="flex:1">✨ إنشاء غرفة</button>
      <button class="btn btn-blue" onclick="showJoinInput()" style="flex:1">🚪 دخول بكود</button>
    </div>
    <div id="join-input-wrap" style="display:none;margin-bottom:12px">
      <div class="lbl">🔑 كود الغرفة</div>
      <div style="display:flex;gap:7px">
        <input id="join-code" type="text" placeholder="مثال: ABCD" maxlength="6" style="text-transform:uppercase;letter-spacing:.15em;font-size:1.1rem;font-weight:900">
        <button class="btn btn-green btn-sm" onclick="OL.joinRoom()" style="width:auto;padding:0 18px">دخول</button>
      </div>
    </div>
    <hr>
    <div class="stitle">🕹️ غرف متاحة للانضمام</div>
    <div id="rooms-list">
      <div class="muted tc" style="padding:20px">جاري التحميل...</div>
    </div>
    <div style="height:20px"></div>
  </div>
</div>

<!-- ======== LOBBY (waiting room) ======== -->
<div id="s-lobby" class="screen">
  <div class="room-header">
    <div class="room-code-lbl">كود الغرفة</div>
    <div class="room-code" id="lobby-code">----</div>
    <div style="display:flex;justify-content:center;gap:8px;margin-top:6px">
      <div style="font-size:.72rem;color:var(--muted)" id="lobby-status">انتظار لاعبين...</div>
      <span class="conn-dot online"></span>
    </div>
  </div>
  <div class="scroll-fix">
    <div class="stitle">👥 اللاعبون في الغرفة <span id="lobby-count">(0)</span></div>
    <div id="lobby-players"></div>
    <div style="padding:10px;background:var(--surface2);border-radius:var(--rs);margin-bottom:12px;font-size:.8rem;color:var(--muted);text-align:center">
      📢 شارك كود الغرفة مع أصدقائك للانضمام
    </div>
  </div>
  <!-- Host controls -->
  <div id="host-controls" style="display:none">
    <div class="host-bar">
      <button class="btn btn-gray btn-sm" style="flex:1" onclick="showScreen('s-online-settings')">⚙️ الإعدادات</button>
      <button class="btn btn-red" style="flex:2" id="start-online-btn" onclick="OL.startGame()">🚀 ابدأ اللعبة</button>
    </div>
  </div>
  <div id="guest-waiting" style="display:none;padding:12px 14px 20px;text-align:center;color:var(--muted);font-size:.85rem">
    ⏳ انتظار الهوست لبدء اللعبة...
  </div>
</div>

<!-- ======== ONLINE SETTINGS (host only) ======== -->
<div id="s-online-settings" class="screen">
  <div class="hdr">
    <div class="hdr-back" onclick="showScreen('s-lobby')">←</div>
    <div class="hdr-title">⚙️ إعدادات اللعبة</div>
    <div style="width:36px"></div>
  </div>
  <div class="scroll-fix">
    <div class="stitle">🃏 الأدوار الخاصة</div>
    <div class="rgrid" id="online-rgrid"></div>
    <div id="online-rwarning" style="color:var(--mafia);font-size:.78rem;text-align:center;margin-top:6px"></div>
    <hr>
    <div class="stitle">⚙️ الإعدادات</div>
    <div class="card">
      <div class="lbl">⏱ وقت النقاش</div>
      <div class="pills" id="online-disc-pills">
        <div class="pill on" data-v="0" onclick="G.pill(this,'online-disc')">بدون</div>
        <div class="pill" data-v="180" onclick="G.pill(this,'online-disc')">3 دقائق</div>
        <div class="pill" data-v="300" onclick="G.pill(this,'online-disc')">5 دقائق</div>
        <div class="pill" data-v="600" onclick="G.pill(this,'online-disc')">10 دقائق</div>
      </div>
    </div>
    <div class="card">
      <div class="trow">
        <span style="font-size:.9rem">🎭 إعلان عدد المافيا للجميع</span>
        <div class="tog" id="tog-online-maf" onclick="togSetting('showMafia')"></div>
      </div>
      <div class="trow">
        <span style="font-size:.9rem">💀 كشف دور المقتول عند موته</span>
        <div class="tog on" id="tog-online-revealdead" onclick="togSetting('revealDead')"></div>
      </div>
      <div class="trow">
        <span style="font-size:.9rem">🔊 الأصوات والمؤثرات</span>
        <div class="tog on" id="tog-online-snd" onclick="togSetting('sounds')"></div>
      </div>
    </div>
    <button class="btn btn-gold" onclick="OL.saveSettings()">💾 حفظ الإعدادات</button>
    <div style="height:20px"></div>
  </div>
</div>

<!-- ======== SETUP (LOCAL) ======== -->
<div id="s-setup" class="screen">
  <div class="hdr">
    <div class="hdr-back" onclick="showScreen('s-land')">←</div>
    <div class="hdr-title">إعداد اللعبة المحلية</div>
    <div style="width:36px"></div>
  </div>
  <div class="scroll-fix">
    <div class="stitle">👥 اللاعبون</div>
    <div id="plist"></div>
    <div style="display:flex;gap:8px;margin-bottom:8px">
      <input id="pinp" type="text" placeholder="اسم اللاعب..." maxlength="14" onkeydown="if(event.key==='Enter')G.addP()">
      <button class="btn btn-gold btn-sm" style="width:auto;padding:0 16px;flex-shrink:0" onclick="G.addP()">+</button>
    </div>
    <div id="pcnt-msg" class="muted tc" style="margin-bottom:12px"></div>
    <hr>
    <div class="stitle">🃏 الأدوار الخاصة</div>
    <div class="rgrid" id="rgrid"></div>
    <div id="rwarning" style="color:var(--mafia);font-size:.78rem;text-align:center;margin-top:6px"></div>
    <hr>
    <div class="stitle">⚙️ الإعدادات</div>
    <div class="card">
      <div class="lbl">⏱ وقت النقاش</div>
      <div class="pills" id="disc-pills">
        <div class="pill on" data-v="0" onclick="G.pill(this,'disc')">بدون</div>
        <div class="pill" data-v="180" onclick="G.pill(this,'disc')">3 دقائق</div>
        <div class="pill" data-v="300" onclick="G.pill(this,'disc')">5 دقائق</div>
        <div class="pill" data-v="600" onclick="G.pill(this,'disc')">10 دقائق</div>
        <div class="pill" data-v="-1" onclick="G.pill(this,'disc')">مخصص</div>
      </div>
      <div id="disc-custom" style="display:none;margin-top:9px">
        <input id="disc-inp" type="number" placeholder="الوقت بالثواني..." min="30" max="9999">
      </div>
    </div>
    <div class="card">
      <div class="trow">
        <span style="font-size:.9rem">🌙 وقت دور الليل (ثانية)</span>
        <input id="night-sec" type="number" value="30" style="width:60px;padding:5px">
      </div>
      <div class="trow">
        <span style="font-size:.9rem">🔊 الأصوات</span>
        <div class="tog on" id="tog-snd" onclick="G.tog('snd')"></div>
      </div>
      <div class="trow">
        <span style="font-size:.9rem">🎭 إعلان عدد المافيا</span>
        <div class="tog" id="tog-maf" onclick="G.tog('maf')"></div>
      </div>
      <div class="trow">
        <span style="font-size:.9rem">🗳 تصويت دوري (هاتف واحد)</span>
        <div class="tog on" id="tog-onevote" onclick="G.tog('onevote')"></div>
      </div>
      <div class="trow">
        <span style="font-size:.9rem">💀 كشف دور المقتول</span>
        <div class="tog on" id="tog-revealdead" onclick="G.tog('revealdead')"></div>
      </div>
    </div>
    <button class="btn btn-red" style="margin-top:4px" onclick="G.start()">🚀 ابدأ اللعبة</button>
    <div style="height:28px"></div>
  </div>
</div>

<!-- ======== PASS PHONE ======== -->
<div id="s-pass" class="screen">
  <div class="pass-inner">
    <div class="pass-icon" id="pass-ico">📱</div>
    <div class="pass-title" id="pass-ttl">مرّر الهاتف!</div>
    <div class="pass-sub" id="pass-sub"></div>
    <button class="btn btn-red" style="max-width:290px;margin:0 auto" id="pass-btn">👁 اضغط للاطلاع على دورك</button>
  </div>
</div>

<!-- ======== ROLE REVEAL ======== -->
<div id="s-role" class="screen">
  <div class="reveal-wrap" id="reveal-wrap">
    <div class="reveal-who" id="reveal-who">اللاعب</div>
    <div class="big-card" id="big-card">
      <div class="big-img" id="big-img"></div>
      <div class="tap-ov" id="tap-ov" onclick="G.tapReveal()">
        <div style="font-size:4.5rem;margin-bottom:15px;filter:drop-shadow(0 0 15px var(--gold))">🎭</div>
        <div style="font-size:1.1rem;font-weight:900;color:var(--gold)">اكشف هويتك</div>
        <div class="muted" style="font-size:.85rem;margin-top:5px">اضغط للكشف سراً</div>
      </div>
      <div class="big-team" id="big-team"></div>
      <div class="big-icon" id="big-icon">🎭</div>
      <div class="big-name" id="big-name">؟؟؟</div>
      <div class="big-desc" id="big-desc"></div>
    </div>
    <button class="btn btn-red" id="role-next" style="display:none;max-width:200px" onclick="G.nextReveal()">التالي ←</button>
  </div>
</div>

<!-- ======== ONLINE ROLE REVEAL (each player on their device) ======== -->
<div id="s-online-role" class="screen">
  <div class="reveal-wrap" id="online-reveal-wrap">
    <div class="reveal-who" id="online-reveal-who">دورك</div>
    <div class="big-card" id="online-big-card">
      <div class="big-img" id="online-big-img"></div>
      <div class="tap-ov" id="online-tap-ov" onclick="OL.tapReveal()">
        <div style="font-size:4.5rem;margin-bottom:15px;filter:drop-shadow(0 0 15px var(--gold))">🎭</div>
        <div style="font-size:1.1rem;font-weight:900;color:var(--gold)">اكشف هويتك</div>
        <div class="muted" style="font-size:.85rem;margin-top:5px">اضغط للكشف سراً</div>
      </div>
      <div class="big-team" id="online-big-team"></div>
      <div class="big-icon" id="online-big-icon">🎭</div>
      <div class="big-name" id="online-big-name">؟؟؟</div>
      <div class="big-desc" id="online-big-desc"></div>
    </div>
    <div id="online-role-btn-wrap" style="display:none;text-align:center">
      <div class="muted" style="font-size:.8rem;margin-bottom:10px">جاهز؟ انتظر بدء الليل</div>
      <div class="muted" id="online-ready-count" style="font-size:.85rem;color:var(--gold)"></div>
    </div>
  </div>
</div>

<!-- ======== ONLINE NIGHT (each player on their device) ======== -->
<div id="s-night-online" class="screen">
  <div class="night-top">
    <div class="rnd-pill">الجولة <span id="on-rnd">1</span></div>
    <div class="phase-lbl">🌙 الليل</div>
    <div id="on-alive" class="muted" style="font-size:.75rem"></div>
  </div>
  <div class="night-hdr">
    <div class="night-emo" id="on-emo">🔴</div>
    <div class="night-rlbl" id="on-rlbl">دورك</div>
    <div class="night-hint" id="on-hint">انتظر...</div>
  </div>
  <div class="tbar-wrap" id="on-tbar-wrap" style="display:none;margin:6px 14px 10px"><div class="tbar" id="on-tbar" style="width:100%"></div></div>
  <div class="ttxt" id="on-ttxt" style="display:none;margin-bottom:5px"></div>
  <div id="on-pick-grid" class="pick-grid"></div>
  <div id="on-sniper-warn" style="text-align:center;padding:8px 14px;font-size:.78rem;color:var(--muted);flex-shrink:0;display:none">
    ⚠️ رصاصة واحدة فقط — إذا أخطأت تُقتل!
  </div>
  <div class="night-footer">
    <button class="btn btn-green" id="on-confirm" style="display:none" onclick="OL.nightConfirm()">✅ تأكيد الاختيار</button>
    <button class="btn btn-ghost btn-sm" onclick="OL.nightSkip()">تخطي — لا أفعل شيئاً</button>
  </div>
</div>

<!-- ======== NIGHT (LOCAL) ======== -->
<div id="s-night" class="screen">
  <div class="night-top">
    <div class="rnd-pill">الجولة <span id="n-rnd">1</span></div>
    <div class="phase-lbl">🌙 الليل</div>
    <div id="n-alive" class="muted" style="font-size:.75rem"></div>
  </div>
  <div class="q-bar" id="qbar"></div>
  <div class="night-hdr">
    <div class="night-emo" id="n-emo">🔴</div>
    <div class="night-rlbl" id="n-rlbl">المافيا</div>
    <div class="night-hint" id="n-hint">اختر ضحيتك الليلة</div>
  </div>
  <div class="tbar-wrap" id="n-tbar-wrap" style="display:none;margin:6px 14px 10px"><div class="tbar" id="n-tbar" style="width:100%"></div></div>
  <div class="ttxt" id="n-ttxt" style="display:none;margin-bottom:5px"></div>
  <div class="pick-grid" id="pick-grid"></div>
  <div id="sniper-warn" style="text-align:center;padding:8px 14px;font-size:.78rem;color:var(--muted);flex-shrink:0;display:none">
    ⚠️ رصاصة واحدة فقط — إذا أخطأت تُقتل!
  </div>
  <div class="night-footer">
    <button class="btn btn-green" id="n-confirm" style="display:none" onclick="G.nightConfirm()">✅ تأكيد الاختيار</button>
    <button class="btn btn-ghost btn-sm" onclick="G.nightSkip()">تخطي — لا أفعل شيئاً</button>
  </div>
</div>

<!-- ======== NIGHT RESULT ======== -->
<div id="s-nresult" class="screen">
  <div class="hdr">
    <div style="width:36px"></div>
    <div class="hdr-title">🌙 ماذا حدث الليلة؟</div>
    <div style="width:36px"></div>
  </div>
  <div class="scroll" id="nres-content" style="display:flex;flex-direction:column;gap:11px"></div>
  <div style="padding:0 14px 22px;flex-shrink:0">
    <button class="btn btn-gold" id="start-day-btn" onclick="startDayAction()">☀️ ابدأ النهار</button>
  </div>
</div>

<!-- ======== VOTE PASS ======== -->
<div id="s-vpass" class="screen">
  <div class="vpass-inner">
    <div style="font-size:3.5rem;margin-bottom:12px">🗳️</div>
    <div style="font-size:1.25rem;font-weight:900;color:var(--gold);margin-bottom:6px">دور التصويت</div>
    <div class="muted" style="margin-bottom:6px">اللاعب:</div>
    <div style="font-size:1.2rem;font-weight:900;margin-bottom:22px" id="vpass-nm"></div>
    <div class="muted" style="margin-bottom:22px;font-size:.85rem">مرّر الهاتف سراً — لا تُظهر الشاشة</div>
    <button class="btn btn-red" style="max-width:290px;margin:0 auto" id="vpass-btn">🗳 صوّت الآن</button>
  </div>
</div>

<!-- ======== DAY ======== -->
<div id="s-day" class="screen">
  <div class="night-top">
    <div class="rnd-pill">الجولة <span id="d-rnd">1</span></div>
    <div class="phase-lbl">☀️ النهار</div>
    <div id="d-alive" class="muted" style="font-size:.75rem"></div>
  </div>
  <div class="tbar-wrap" id="tbar-wrap" style="display:none"><div class="tbar" id="tbar" style="width:100%"></div></div>
  <div class="ttxt" id="ttxt" style="display:none"></div>
  <div id="disc-msg" style="text-align:center;padding:8px 14px 2px;font-size:.83rem;color:var(--muted);flex-shrink:0">
    🗣 ناقشوا ثم صوّتوا!
  </div>
  <div class="day-list" id="day-list"></div>
  <div class="day-footer">
    <div id="vote-progress" class="muted tc" style="font-size:.8rem"></div>
    <button class="btn btn-purple btn-sm" onclick="G.startVoting()" id="start-vote-btn">🗳️ ابدأ التصويت</button>
    <button class="btn btn-red btn-sm" id="exec-btn" style="display:none" onclick="execVoteAction()">⚖️ إعدام بالأغلبية</button>
    <button class="btn btn-purple btn-sm" id="skip-turn-btn" style="display:none" onclick="G.skipVoteTurn()">⏭️ تخطي دوري</button>
    <div style="display:flex;gap:7px">
      <button class="btn btn-gray btn-sm" style="flex:1" onclick="skipExecAction()">🕊️ عفو عام</button>
      <button class="btn btn-ghost btn-sm" style="flex:1" onclick="endDayAction()">🌙 انتهى النهار</button>
    </div>
  </div>
</div>

<!-- ======== GAME OVER ======== -->
<div id="s-result" class="screen">
  <div class="res-wrap">
    <div class="res-icon" id="res-ico">🏆</div>
    <div class="res-title" id="res-ttl">انتهت اللعبة!</div>
    <div class="res-sub" id="res-sub"></div>
    <div class="card roles-reveal-list" id="rrl"></div>
    <div style="display:flex;flex-direction:column;gap:9px;max-width:300px;margin:0 auto">
      <button class="btn btn-red" id="restart-btn" onclick="restartAction()">🔄 العب مرة أخرى (أدوار جديدة)</button>
      <button class="btn btn-gray" onclick="showScreen('s-land')">🏠 الرئيسية</button>
    </div>
    <div style="height:24px"></div>
  </div>
</div>

<!-- ======== RULES ======== -->
<div id="s-rules" class="screen">
  <div class="hdr">
    <div class="hdr-back" onclick="showScreen('s-land')">←</div>
    <div class="hdr-title">📖 قواعد اللعبة</div>
    <div style="width:36px"></div>
  </div>
  <div class="scroll" id="rules-content"></div>
</div>

<!-- ======== DETECTIVE MODAL ======== -->
<div class="modal-bg" id="m-det">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title">🔍 نتيجة التحقيق</div>
    <div id="det-res" style="text-align:center;padding:14px 0"></div>
    <button class="btn btn-gray" onclick="closeDet()">حسناً ✓</button>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- CHAT BUTTON -->
<button class="chat-btn" id="chat-btn" onclick="toggleChat()">
  💬
  <span class="chat-badge" id="chat-badge">0</span>
</button>

<!-- CHAT OVERLAY -->
<div class="chat-ov" id="chat-ui">
  <div class="chat-tabs">
    <div class="chat-tab active" id="tab-global" onclick="setChat('global')">💬 العامة</div>
    <div class="chat-tab" id="tab-mafia" onclick="setChat('mafia')" style="display:none">🔴 المافيا</div>
  </div>
  <div class="chat-msgs" id="chat-msgs"></div>
  <div class="chat-inp-wrap">
    <input id="chat-inp" placeholder="اكتب رسالة..." onkeydown="if(event.key==='Enter')sendChatMsg()">
    <button class="btn btn-gold btn-sm" onclick="sendChatMsg()" style="width:auto;padding:0 12px">إرسال</button>
  </div>
</div>

<div id="night-overlay" style="position:fixed;inset:0;pointer-events:none;z-index:999"></div>

<!-- Firebase SDK -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getDatabase, ref, set, get, push, onValue, off, update, remove, serverTimestamp, onDisconnect }
  from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

// ─────────────────────────────────────────────
//  FIREBASE CONFIG — Replace with your own from firebase.google.com (free)
//  Go to: console.firebase.google.com → New Project → Realtime Database → Rules: allow read,write: true
// ─────────────────────────────────────────────
const firebaseConfig = {
  apiKey: "AIzaSyD14CFqocnq-18K72wz9LGh62PqnFnXXtw",
  authDomain: "mafiagame-online.firebaseapp.com",
