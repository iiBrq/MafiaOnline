// ─────────────────────────────────────────────
//  ROLE DEFINITIONS
// ─────────────────────────────────────────────
window.RD = {
  mafia:       {n:'المافيا',ic:'🔴',col:'var(--mafia)',gl:'var(--mafia-g)',team:'مافيا',d:'تقتل شخصاً كل ليلة. اخفِ هويتك!',img:'mafia.png'},
  godfather:   {n:'العراب',ic:'🕶️',col:'var(--mafia)',gl:'var(--mafia-g)',team:'مافيا',d:'رئيس المافيا. إذا فحصك المحقق يظهر له بريئاً!',img:'boss.png'},
  civil:       {n:'مدني',ic:'🔵',col:'var(--civil)',gl:'var(--civil-g)',team:'مدنيون',d:'كشف المافيا والبقاء حياً.',img:'civil.png'},
  doctor:      {n:'الطبيب',ic:'💚',col:'var(--doctor)',gl:'var(--doctor-g)',team:'مدنيون',d:'أنقذ شخصاً واحداً كل ليلة (مرة واحدة لنفسك).',img:'civil.png'},
  bodyguard:   {n:'الحارس',ic:'🛡️',col:'var(--doctor)',gl:'var(--doctor-g)',team:'مدنيون',d:'تحمي شخصاً، وإذا هوجم، تموت بدلاً منه!',img:'Bodyguard.png'},
  detective:   {n:'المحقق',ic:'🟡',col:'var(--detective)',gl:'var(--detective-g)',team:'مدنيون',d:'افحص هوية لاعب كل ليلة.',img:'detective.png'},
  sniper:      {n:'القناص',ic:'🟣',col:'var(--sniper)',gl:'var(--sniper-g)',team:'مدنيون',d:'رصاصة واحدة: تقتل المافيا أو تموت أنت!',img:'sniper.jpg'},
  jester:      {n:'المهرج',ic:'🤡',col:'#ff006e',gl:'#ff006e30',team:'محايد',d:'هدفك أن يتم إعدامك في النهار لتفوز!',img:'jester.jpg'},
  blackmailer: {n:'المبتز',ic:'🤫',col:'#3a0ca3',gl:'#3a0ca330',team:'مافيا',d:'اختر لاعباً لتمنعه من التصويت غداً.',img:'blackmailer.png'},
  mayor:       {n:'العمدة',ic:'🎩',col:'#4361ee',gl:'#4361ee30',team:'مدنيون',d:'صوتك في النهار يُحسب بصوتين.',img:'boss.png'},
  witch:       {n:'الساحرة',ic:'🧪',col:'#7209b7',gl:'#7209b730',team:'مدنيون',d:'تقتل أو تنقذ لاعباً (قدرة تستخدم بحذر).',img:'Witch.jpg'},
  serialKiller:{n:'القاتل المتسلسل',ic:'🔪',col:'#f72585',gl:'#f7258530',team:'محايد',d:'تقتل شخصاً كل ليلة. فوزك البقاء وحيداً!',img:'Assassin.png'},
};

window.AVC=['av0','av1','av2','av3','av4','av5','av6','av7','av8','av9','av10','av11'];

// ─────────────────────────────────────────────
//  AUDIO
// ─────────────────────────────────────────────
let _ctx;
function ac(){if(!_ctx)_ctx=new(window.AudioContext||window.webkitAudioContext)();return _ctx}
window.snd=function(type){
  if(!G.s.sounds)return;
  try{
    const c=ac(),o=c.createOscillator(),g=c.createGain();
    o.connect(g);g.connect(c.destination);
    const t=c.currentTime;
    if(type==='kill'){o.type='sawtooth';o.frequency.setValueAtTime(260,t);o.frequency.exponentialRampToValueAtTime(50,t+.6);g.gain.setValueAtTime(.3,t);g.gain.exponentialRampToValueAtTime(.001,t+.65);o.start();o.stop(t+.65);}
    else if(type==='protect'){o.type='sine';[523,659,784].forEach((f,i)=>o.frequency.setValueAtTime(f,t+i*.12));g.gain.setValueAtTime(.2,t);g.gain.exponentialRampToValueAtTime(.001,t+.5);o.start();o.stop(t+.55);}
    else if(type==='click'){o.type='sine';o.frequency.setValueAtTime(900,t);g.gain.setValueAtTime(.08,t);g.gain.exponentialRampToValueAtTime(.001,t+.08);o.start();o.stop(t+.1);}
    else if(type==='win'){[523,659,784,1047].forEach((f,i)=>{const oo=c.createOscillator(),gg=c.createGain();oo.connect(gg);gg.connect(c.destination);oo.type='sine';oo.frequency.setValueAtTime(f,t+i*.15);gg.gain.setValueAtTime(.18,t+i*.15);gg.gain.exponentialRampToValueAtTime(.001,t+i*.15+.4);oo.start(t+i*.15);oo.stop(t+i*.15+.5);});}
    else if(type==='vote-kill'){o.type='square';o.frequency.setValueAtTime(500,t);o.frequency.exponentialRampToValueAtTime(80,t+.9);g.gain.setValueAtTime(.25,t);g.gain.exponentialRampToValueAtTime(.001,t+1);o.start();o.stop(t+1);}
    else if(type==='msg'){o.type='sine';o.frequency.setValueAtTime(1200,t);g.gain.setValueAtTime(.06,t);g.gain.exponentialRampToValueAtTime(.001,t+.12);o.start();o.stop(t+.15);}
  }catch(e){}
};

// ─────────────────────────────────────────────
//  UTILITY
// ─────────────────────────────────────────────
window.showScreen=function(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const el=document.getElementById(id);
  if(el)el.classList.add('active');
  window.scrollTo(0,0);
};

window.toast=function(msg,ms=2400){
  const t=document.getElementById('toast');
  if(!t)return;
  t.textContent=msg;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),ms);
};

window.ava=function(i){return`av${(i||0)%12}`};

// ─────────────────────────────────────────────
//  ONLINE MULTIPLAYER
// ─────────────────────────────────────────────
window.OL={
  roomId:null, myName:null, isHost:false,
  myRole:null, players:[], settings:{},
  roomRef:null, nightAction:null, chatType:'global',
  unsubscribers:[], revealShown:false, sniperFired:false,

  genCode(){
    const chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let c='';for(let i=0;i<4;i++)c+=chars[Math.floor(Math.random()*chars.length)];
    return c;
  },

  async createRoom(){
    if(!db){toast('⚠️ Firebase غير مكوّن. اطلع على README لإعداد قاعدة البيانات.');return;}
    const name=document.getElementById('online-name').value.trim();
    if(!name){toast('أدخل اسمك أولاً!');return;}
    const code=this.genCode();
    this.roomId=code; this.myName=name; this.isHost=true;
    const roomData={
      code, hostName:name, status:'waiting', round:1, phase:'lobby',
      settings:{mafia:1,godfather:0,doctor:0,detective:0,sniper:0,bodyguard:0,jester:0,blackmailer:0,mayor:0,witch:0,serialKiller:0,discTime:0,sounds:true,showMafia:false,revealDead:true},
      players:{},chat:{},nightActions:{},votes:{},created:Date.now()
    };
    await set(ref(db,`rooms/${code}`),roomData);
    await set(ref(db,`rooms/${code}/players/${name}`),{name,alive:true,role:'',isHost:true,joinedAt:Date.now()});
    onDisconnect(ref(db,`rooms/${code}/players/${name}`)).remove();
    this.enterLobby(code);
  },

  async joinRoom(){
    if(!db){toast('⚠️ Firebase غير مكوّن.');return;}
    const name=document.getElementById('online-name').value.trim();
    const code=(document.getElementById('join-code').value.trim()).toUpperCase();
    if(!name){toast('أدخل اسمك!');return;}
    if(!code||code.length<3){toast('أدخل كود الغرفة!');return;}
    const snap=await get(ref(db,`rooms/${code}`));
    if(!snap.exists()){toast('❌ الغرفة غير موجودة!');return;}
    const rd=snap.val();
    if(rd.status!=='waiting'){toast('❌ اللعبة بدأت بالفعل!');return;}
    if(rd.players&&rd.players[name]){toast('الاسم مستخدم مسبقاً في الغرفة، غيّر اسمك');return;}
    const pCount=rd.players?Object.keys(rd.players).length:0;
    if(pCount>=12){toast('الغرفة ممتلئة (12 لاعب)');return;}
    this.roomId=code; this.myName=name; this.isHost=false;
    await set(ref(db,`rooms/${code}/players/${name}`),{name,alive:true,role:'',isHost:false,joinedAt:Date.now()});
    onDisconnect(ref(db,`rooms/${code}/players/${name}`)).remove();
    this.enterLobby(code);
  },

  async joinByCode(code){
    document.getElementById('online-name').value = document.getElementById('online-name').value||'';
    document.getElementById('join-code').value=code;
    showJoinInput();
  },

  enterLobby(code){
    document.getElementById('lobby-code').textContent=code;
    showScreen('s-lobby');
    document.getElementById('chat-btn').style.display='block';
    this.listenRoom();
  },

  listenRoom(){
    if(!db)return;
    const rr=ref(db,`rooms/${this.roomId}`);
    const unsub=onValue(rr,snap=>{
      if(!snap.exists()){toast('انتهت الغرفة');showScreen('s-land');return;}
      const d=snap.val();
      this.players=Object.values(d.players||{}).sort((a,b)=>a.joinedAt-b.joinedAt);
      this.settings=d.settings||{};
      this.renderLobby(d);
      this.handlePhaseChange(d);
    });
    this.unsubscribers.push(()=>off(rr));
    // Chat listener
    const cr=ref(db,`rooms/${this.roomId}/chat`);
    const cu=onValue(cr,snap=>{
      if(!snap.exists())return;
      const msgs=snap.val();
      // Only handle new messages
      const allMsgs=Object.values(msgs).sort((a,b)=>a.ts-b.ts);
      this.renderChat(allMsgs);
    });
    this.unsubscribers.push(()=>off(cr));
    // Online roles settings
    if(this.isHost){
      document.getElementById('host-controls').style.display='block';
      document.getElementById('guest-waiting').style.display='none';
      G.roles={mafia:1,godfather:0,doctor:0,detective:0,sniper:0,bodyguard:0,jester:0,blackmailer:0,mayor:0,witch:0,serialKiller:0};
      this.renderOnlineRGrid();
    } else {
      document.getElementById('host-controls').style.display='none';
      document.getElementById('guest-waiting').style.display='block';
    }
  },

  renderLobby(d){
    const el=document.getElementById('lobby-players');
    document.getElementById('lobby-count').textContent=`(${this.players.length})`;
    el.innerHTML=this.players.map((p,i)=>`
      <div class="player-lobby-card ${p.isHost?'host-p':''}">
        <div class="p-ava ${ava(i)}">${p.name[0].toUpperCase()}</div>
        <div style="flex:1">
          <div class="bold">${p.name}</div>
          ${p.isHost?'<span class="host-crown">👑 هوست</span>':'<span style="font-size:.72rem;color:var(--muted)">لاعب</span>'}
        </div>
        ${p.name===this.myName?'<span style="font-size:.72rem;color:var(--gold)">أنت</span>':''}
      </div>`).join('');
    document.getElementById('lobby-status').textContent=`${this.players.length} لاعب — ${d.status==='waiting'?'انتظار...':'جارٍ اللعب'}`;
  },

  handlePhaseChange(d){
    const phase=d.phase;
    if(phase==='role-reveal'&&!this.revealShown){
      this.revealShown=true;
      const me=d.players[this.myName];
      if(me)this.myRole=me.role;
      this.showMyRole(d);
    }
    if(phase==='night'){
      showScreen('s-night-online');
      this.renderOnlineNight(d);
    }
    if(phase==='night-result'){
      G.players=this.players;
      G.renderNightResult(d.nightResults||[]);
      // Only host shows continue button
      document.getElementById('start-day-btn').style.display=this.isHost?'flex':'none';
    }
    if(phase==='day'){
      G.players=this.players.map(p=>({...p}));
      G.votes=d.votes||{};
      G.votedBy=d.votedBy||{};
      G.round=d.round||1;
      G.s=this.settings;
      G.renderDayOnline(d);
      showScreen('s-day');
    }
    if(phase==='result'){
      G.players=this.players.map(p=>({...p}));
      G.showResult(d.winner);
    }
    // Settings sync
    if(d.settings&&!this.isHost){
      this.settings=d.settings;
      G.roles=d.settings;
    }
  },

  showMyRole(d){
    const me=d.players[this.myName];
    if(!me)return;
    const r=RD[me.role]||RD.civil;
    const card=document.getElementById('online-big-card');
    card.style.setProperty('--rc',r.col);
    card.style.setProperty('--rg',r.gl);
    document.getElementById('online-big-team').textContent=r.team;
    document.getElementById('online-big-team').style.background=r.col+'20';
    document.getElementById('online-big-team').style.color=r.col;
    document.getElementById('online-big-team').style.borderColor=r.col+'40';
    document.getElementById('online-big-icon').textContent=r.ic;
    document.getElementById('online-big-name').textContent=r.n;
    document.getElementById('online-big-name').style.color=r.col;
    document.getElementById('online-big-img').style.backgroundImage=`url('${r.img}')`;
    document.getElementById('online-reveal-who').textContent=`دورك يا ${this.myName}`;
    let desc=r.d;
    if(me.role==='mafia'||me.role==='godfather'){
      const teammates=this.players.filter(p=>(p.role==='mafia'||p.role==='godfather')&&p.name!==this.myName).map(p=>p.name);
      if(teammates.length)desc+=` | 👥 زملاؤك: ${teammates.join('، ')}`;
      document.getElementById('tab-mafia').style.display='block';
    }
    document.getElementById('online-big-desc').textContent=desc;
    document.getElementById('online-tap-ov').classList.remove('gone');
    document.getElementById('online-role-btn-wrap').style.display='none';
    showScreen('s-online-role');
    // Mark ready after tap
  },

  tapReveal(){
    document.getElementById('online-tap-ov').classList.add('gone');
    document.getElementById('online-role-btn-wrap').style.display='block';
    snd('click');
    // Signal ready
    update(ref(db,`rooms/${this.roomId}/ready`),{[this.myName]:true});
  },

  renderOnlineNight(d){
    const me=d.players?.[this.myName];
    if(!me||!me.alive){
      document.getElementById('on-hint').textContent='أنت خارج اللعبة — انتظر النتيجة';
      document.getElementById('on-pick-grid').innerHTML='<div class="muted tc" style="grid-column:1/-1;padding:40px 14px">💀 أنت ميت — انتظر نتيجة الليل</div>';
      return;
    }
    const role=me.role;
    const r=RD[role]||RD.civil;
    document.getElementById('on-emo').textContent=r.ic;
    document.getElementById('on-rlbl').textContent=r.n;
    document.getElementById('on-rnd').textContent=d.round||1;
    document.getElementById('on-alive').textContent=`${this.players.filter(p=>p.alive).length} أحياء`;
    const hasAction=['mafia','godfather','doctor','detective','sniper','bodyguard','blackmailer','witch','serialKiller'].includes(role);
    const sniperDone=d.players?.[this.myName]?.sniperFired;
    if(!hasAction||(role==='sniper'&&sniperDone)){
      document.getElementById('on-hint').textContent='أنت نائم الليلة... انتظر';
      document.getElementById('on-pick-grid').innerHTML='<div class="muted tc" style="grid-column:1/-1;padding:40px 14px">لا يوجد إجراء لك هذه الليلة 😴</div>';
      document.getElementById('on-confirm').style.display='none';
      return;
    }
    const hints={mafia:'اختر ضحيتك الليلة',godfather:'اختر ضحيتك الليلة',doctor:'من تنقذ الليلة؟',detective:'من تحقق في هويته؟',sniper:'استخدم رصاصتك!',blackmailer:'من تُسكت غداً؟',witch:'اختر هدفك',serialKiller:'اختر ضحيتك!'};
    document.getElementById('on-hint').textContent=hints[role]||'';
    document.getElementById('on-sniper-warn').style.display=role==='sniper'?'block':'none';
    this.nightAction=null;
    document.getElementById('on-confirm').style.display='none';
    this.renderOnlinePickGrid(role,d);
    // Night timer
    G.startTimer(d.settings?.nightTime||30,'on-tbar','on-ttxt','on-tbar-wrap',()=>{
      if(!this.nightAction)this.nightSkip();else this.nightConfirm();
    });
  },

  renderOnlinePickGrid(role,d){
    const r=RD[role];
    const mafias=this.players.filter(p=>p.role==='mafia'||p.role==='godfather').map(p=>p.name);
    const myPlayer=d.players?.[this.myName];
    const alive=this.players.filter(p=>p.alive);
    document.getElementById('on-pick-grid').innerHTML=alive.map((p,pi)=>{
      let disabled=false;
      if(role==='doctor'&&p.name===this.myName&&myPlayer?.docSelfUsed)disabled=true;
      if(['mafia','godfather','blackmailer'].includes(role)&&(p.role==='mafia'||p.role==='godfather'||p.role==='blackmailer'))disabled=true;
      const globalIdx=this.players.findIndex(x=>x.name===p.name);
      return `<div class="pick-card ${disabled?'dead':''}" id="onpc-${p.name}"
        style="--rc:${r.col};--rg:${r.gl}" onclick="${disabled?'':'OL.pickN(\''+p.name+'\')'}">
        <div class="pick-tick">✓</div>
        <div class="pick-ava ${ava(globalIdx)}">${p.name[0].toUpperCase()}</div>
        <div class="pick-nm">${p.name}</div>
        ${(['mafia','godfather'].includes(role)&&mafias.includes(p.name))?'<div class="mafia-team-badge">مافيا</div>':''}
        ${disabled?'<div style="font-size:.68rem;color:var(--muted);margin-top:3px">لا يمكن</div>':''}
      </div>`;
    }).join('');
  },

  pickN(name){
    document.querySelectorAll('.pick-card').forEach(c=>c.classList.remove('on'));
    const el=document.getElementById('onpc-'+name);
    if(el)el.classList.add('on');
    this.nightAction=name;
    document.getElementById('on-confirm').style.display='flex';
    snd('click');
  },

  async nightConfirm(){
    if(!this.nightAction){toast('اختر لاعباً أولاً!');return;}
    const me=this.players.find(p=>p.name===this.myName);
    if(!me)return;
    const role=me.role;
    if(role==='detective'){
      const target=this.players.find(p=>p.name===this.nightAction);
      const isMaf=target&&(target.role==='mafia');
      document.getElementById('det-res').innerHTML=`
        <div style="font-size:2.8rem;margin-bottom:10px">${isMaf?'🔴':'🟢'}</div>
        <div style="font-size:1.05rem;font-weight:900;margin-bottom:5px">${this.nightAction}</div>
        <div style="font-size:.95rem;color:${isMaf?'var(--mafia)':'var(--doctor)'};font-weight:700">
          ${isMaf?'⚠️ هذا الشخص مافيا!':'✅ هذا الشخص بريء'}</div>`;
      document.getElementById('m-det').classList.add('show');
      window._detCallback=()=>this._submitNight();
      return;
    }
    await this._submitNight();
  },

  async _submitNight(){
    G.stopTimer();
    const me=this.players.find(p=>p.name===this.myName);
    const role=me?.role;
    const actRole=(role==='godfather')?'mafia':role;
    await update(ref(db,`rooms/${this.roomId}/nightActions`),{[actRole]:this.nightAction||'skip'});
    await update(ref(db,`rooms/${this.roomId}/nightDone`),{[this.myName]:true});
    document.getElementById('on-pick-grid').innerHTML='<div class="muted tc" style="grid-column:1/-1;padding:40px 14px">✅ تم تسليم اختيارك! انتظر الآخرين...</div>';
    document.getElementById('on-confirm').style.display='none';
    // If host, check if all acted
    if(this.isHost)this.checkNightComplete();
  },

  nightSkip(){
    G.stopTimer();
    update(ref(db,`rooms/${this.roomId}/nightDone`),{[this.myName]:true});
    document.getElementById('on-pick-grid').innerHTML='<div class="muted tc" style="grid-column:1/-1;padding:40px 14px">⏭️ تم التخطي! انتظر الآخرين...</div>';
    document.getElementById('on-confirm').style.display='none';
    if(this.isHost)this.checkNightComplete();
  },

  checkNightComplete(){
    if(!this.isHost)return;
    const aliveNames=this.players.filter(p=>p.alive).map(p=>p.name);
    get(ref(db,`rooms/${this.roomId}/nightDone`)).then(snap=>{
      const done=snap.val()||{};
      const allDone=aliveNames.every(n=>done[n]);
      if(allDone)this.processNightServer();
    });
  },

  async processNightServer(){
    const snap=await get(ref(db,`rooms/${this.roomId}`));
    const d=snap.val();
    const acts=d.nightActions||{};
    const ps=Object.values(d.players||{});
    const results=[];
    ps.forEach(p=>p.protected=false);

    // Doctor
    const docT=acts['doctor'];
    if(docT&&docT!=='skip'){const p=ps.find(x=>x.name===docT);if(p)p.protected=true;}
    // Bodyguard
    const bgT=acts['bodyguard'];
    if(bgT&&bgT!=='skip'){const p=ps.find(x=>x.name===bgT);if(p)p.protected=true;}
    // Mafia
    const mafT=acts['mafia'];
    if(mafT&&mafT!=='skip'){
      const t=ps.find(x=>x.name===mafT);
      if(t&&t.protected){results.push({type:'protected',name:t.name});snd('protect');}
      else if(t){t.alive=false;results.push({type:'killed',name:t.name,role:t.role});snd('kill');}
    } else {results.push({type:'safe'});}
    // Sniper
    const snpT=acts['sniper'];
    if(snpT&&snpT!=='skip'){
      const t=ps.find(x=>x.name===snpT);
      const snpr=ps.find(x=>x.role==='sniper');
      if(t&&(t.role==='mafia'||t.role==='godfather')){t.alive=false;results.push({type:'sniper-hit',name:t.name});}
      else{if(snpr)snpr.alive=false;results.push({type:'sniper-miss',tName:snpT,sName:snpr?.name});}
    }
    // Serial Killer
    const skT=acts['serialKiller'];
    if(skT&&skT!=='skip'){const t=ps.find(x=>x.name===skT);if(t&&!t.protected){t.alive=false;results.push({type:'killed',name:t.name,role:t.role});}}
    // Blackmailer
    const blT=acts['blackmailer'];

    // Update players in DB
    const pUpdate={};
    ps.forEach(p=>{pUpdate[p.name]={...p,protected:false};});
    await update(ref(db,`rooms/${this.roomId}/players`),pUpdate);
    await update(ref(db,`rooms/${this.roomId}`),{
      phase:'night-result',nightResults:results,silenced:blT||null,
      nightActions:{},nightDone:{}
    });
    setTimeout(()=>this.checkWinOnline(ps),1500);
  },

  async checkWinOnline(ps){
    const alive=ps.filter(p=>p.alive);
    const mc=alive.filter(p=>p.role==='mafia'||p.role==='godfather').length;
    const cc=alive.filter(p=>p.role!=='mafia'&&p.role!=='godfather').length;
    const sk=alive.find(p=>p.role==='serialKiller');
    let winner=null;
    if(sk&&alive.length<=2)winner='serialKiller';
    else if(mc===0)winner='civil';
    else if(mc>=cc)winner='mafia';
    if(winner){await update(ref(db,`rooms/${this.roomId}`),{phase:'result',winner});}
  },

  async startDay(){
    if(!this.isHost)return;
    const snap=await get(ref(db,`rooms/${this.roomId}/players`));
    const ps=snap.val()||{};
    await update(ref(db,`rooms/${this.roomId}`),{phase:'day',votes:{},votedBy:{},silenced:null});
  },

  async submitVote(targetName){
    if(!db)return;
    await update(ref(db,`rooms/${this.roomId}/votes`),{[this.myName]:targetName});
    toast('✅ تم تسجيل صوتك');
  },

  async execOnlineVote(){
    if(!this.isHost)return;
    const snap=await get(ref(db,`rooms/${this.roomId}`));
    const d=snap.val();
    const vs=d.votes||{};
    const counts={};
    Object.values(vs).forEach(v=>{if(v)counts[v]=(counts[v]||0)+1;});
    if(!Object.keys(counts).length){toast('لا أصوات!');return;}
    const max=Math.max(...Object.values(counts));
    const cands=Object.keys(counts).filter(k=>counts[k]===max);
    if(cands.length>1){toast('تعادل! لا إعدام');setTimeout(()=>this.endDayOnline(),1200);return;}
    const target=cands[0];
    const tp=this.players.find(p=>p.name===target);
    if(!tp)return;
    if(tp.role==='jester'){await update(ref(db,`rooms/${this.roomId}`),{phase:'result',winner:'jester'});return;}
    await update(ref(db,`rooms/${this.roomId}/players/${target}`),{alive:false});
    snd('vote-kill');
    toast(`⚖️ تم إعدام ${target}!`);
    // Check win
    const newPs=this.players.map(p=>p.name===target?{...p,alive:false}:p);
    setTimeout(()=>this.checkWinOnline(newPs),1500);
    setTimeout(()=>this.endDayOnline(),2000);
  },

  async endDayOnline(){
    if(!this.isHost)return;
    const snap=await get(ref(db,`rooms/${this.roomId}`));
    const d=snap.val();
    const round=(d.round||1)+1;
    await update(ref(db,`rooms/${this.roomId}`),{phase:'night',round,nightActions:{},nightDone:{},votes:{},votedBy:{}});
  },

  async startGame(){
    if(!db){toast('Firebase غير مكوّن');return;}
    const n=this.players.length;
    if(n<4){toast('تحتاج 4 لاعبين على الأقل!');return;}
    // Build pool
    const s=this.settings;
    let pool=[];
    const roles=['mafia','godfather','doctor','bodyguard','detective','sniper','jester','blackmailer','mayor','witch','serialKiller'];
    roles.forEach(k=>{for(let i=0;i<(s[k]||0);i++)pool.push(k);});
    while(pool.length<n)pool.push('civil');
    // Shuffle
    for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}
    const pArr=[...this.players];
    for(let i=pArr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pArr[i],pArr[j]]=[pArr[j],pArr[i]];}
    const pUpdate={};
    pArr.forEach((p,i)=>{pUpdate[p.name]={...p,role:pool[i],alive:true,protected:false};});
    await update(ref(db,`rooms/${this.roomId}/players`),pUpdate);
    await update(ref(db,`rooms/${this.roomId}`),{phase:'role-reveal',status:'playing',round:1,settings:this.settings,nightActions:{},nightDone:{},votes:{}});
  },

  async saveSettings(){
    if(!this.isHost)return;
    const s={
      mafia:G.roles.mafia||1, godfather:G.roles.godfather||0,
      doctor:G.roles.doctor||0, bodyguard:G.roles.bodyguard||0,
      detective:G.roles.detective||0, sniper:G.roles.sniper||0,
      jester:G.roles.jester||0, blackmailer:G.roles.blackmailer||0,
      mayor:G.roles.mayor||0, witch:G.roles.witch||0,
      serialKiller:G.roles.serialKiller||0,
      discTime:G.s.discTime||0, sounds:G.s.sounds!==false,
      showMafia:G.s.showMafia||false, revealDead:G.s.revealDead!==false,
      nightTime:30
    };
    this.settings=s;
    await update(ref(db,`rooms/${this.roomId}/settings`),s);
    toast('✅ تم حفظ الإعدادات');
    showScreen('s-lobby');
  },

  renderOnlineRGrid(){
    G.roles={mafia:1,godfather:0,doctor:0,detective:0,sniper:0,bodyguard:0,jester:0,blackmailer:0,mayor:0,witch:0,serialKiller:0};
    G.s={sounds:true,showMafia:false,revealDead:true,discTime:0};
    G.players=this.players;
    const el=document.getElementById('online-rgrid');
    if(!el)return;
    const keys=['mafia','doctor','detective','sniper','godfather','blackmailer','bodyguard','mayor','witch','jester','serialKiller'];
    el.innerHTML=keys.map(k=>{
      const r=RD[k],c=G.roles[k],on=c>0;
      return `<div class="rcrd ${on?'on':''}" id="or-${k}" style="${on?'--rc:'+r.col+';--rg:'+r.gl:''}">
        ${on?`<div class="rcrd-cnt" style="background:${r.col}">${c}</div>`:''}
        <div class="rcrd-icon">${r.ic}</div>
        <div class="rcrd-name" style="${on?'color:'+r.col:''}">${r.n}</div>
        <div class="ccrow">
          <div class="ccbtn" onclick="onlineAdjRole('${k}',-1)">−</div>
          <div class="ccval" id="orv-${k}">${c}</div>
          <div class="ccbtn" onclick="onlineAdjRole('${k}',1)">+</div>
        </div>
      </div>`;
    }).join('');
    const civ=Math.max(0,this.players.length-G.roles.mafia-(G.roles.doctor+G.roles.detective+G.roles.sniper+G.roles.bodyguard+G.roles.godfather+G.roles.mayor+G.roles.witch));
    el.innerHTML+=`<div class="rcrd on" style="--rc:var(--civil);--rg:var(--civil-g);grid-column:1/-1;border-color:var(--civil);display:flex;align-items:center;gap:10px;padding:12px 14px">
      <div class="rcrd-cnt" style="background:var(--civil);position:static;margin:0" id="civ-cnt">${civ}</div>
      <span style="font-size:1.3rem">🔵</span>
      <span class="rcrd-name" style="color:var(--civil);font-size:.85rem">مدنيون — محسوبون تلقائياً</span>
    </div>`;
  },

  // Chat
  sendMsg(type){
    if(!db)return;
    const inp=document.getElementById('chat-inp');
    const msg=inp.value.trim();
    if(!msg)return;
    const me=this.players.find(p=>p.name===this.myName);
    if(type==='mafia'&&me&&me.role!=='mafia'&&me.role!=='godfather'){toast('قناة المافيا للمافيا فقط');return;}
    const msgData={sender:this.myName,msg,type,ts:Date.now(),isMe:true};
    push(ref(db,`rooms/${this.roomId}/chat`),msgData);
    inp.value='';
    snd('click');
  },

  renderChat(msgs){
    const el=document.getElementById('chat-msgs');
    const me=this.players.find(p=>p.name===this.myName);
    const isMafia=me&&(me.role==='mafia'||me.role==='godfather');
    el.innerHTML=msgs.filter(m=>{
      if(m.type==='mafia'&&!isMafia)return false;
      return true;
    }).map(m=>`
      <div class="msg ${m.sender===this.myName?'me':''} ${m.type==='mafia'?'mafia-msg':''}">
        <div class="msg-sender">${m.sender}${m.type==='mafia'?' 🔴':''}</div>
        ${m.msg}
      </div>`).join('');
    el.scrollTop=el.scrollHeight;
  },

  async loadRooms(){
    if(!db){document.getElementById('rooms-list').innerHTML='<div class="muted tc" style="padding:20px">⚠️ Firebase غير مكوّن — اطلع على README.md</div>';return;}
    const snap=await get(ref(db,'rooms'));
    if(!snap.exists()){document.getElementById('rooms-list').innerHTML='<div class="muted tc" style="padding:20px">لا توجد غرف متاحة حالياً</div>';return;}
    const rooms=Object.values(snap.val()).filter(r=>r.status==='waiting'&&r.players&&Object.keys(r.players).length<12);
    if(!rooms.length){document.getElementById('rooms-list').innerHTML='<div class="muted tc" style="padding:20px">لا توجد غرف متاحة — أنشئ غرفة جديدة!</div>';return;}
    rooms.sort((a,b)=>b.created-a.created);
    document.getElementById('rooms-list').innerHTML=rooms.slice(0,8).map(r=>`
      <div class="room-item" onclick="OL.joinByCode('${r.code}')">
        <div>
          <div class="room-code-sm">${r.code}</div>
        </div>
        <div class="room-info">
          <div class="bold" style="font-size:.9rem">غرفة ${r.hostName}</div>
          <div style="font-size:.75rem;color:var(--muted)">${Object.keys(r.players).length} / 12 لاعب</div>
        </div>
        <span class="room-status waiting">انتظار</span>
      </div>`).join('');
  },

  async restartOnline(){
    if(!this.isHost)return;
    this.revealShown=false;
    const pUpdate={};
    this.players.forEach(p=>{pUpdate[p.name]={...p,role:'',alive:true,protected:false};});
    await update(ref(db,`rooms/${this.roomId}/players`),pUpdate);
    await update(ref(db,`rooms/${this.roomId}`),{phase:'lobby',status:'waiting',round:1,winner:null,nightActions:{},nightDone:{},votes:{},votedBy:{},nightResults:null});
    showScreen('s-lobby');
    toast('🔄 جاهز للجولة الجديدة!');
  }
};

// ─────────────────────────────────────────────
//  ONLINE ROLE GRID HANDLER
// ─────────────────────────────────────────────
window.onlineAdjRole=function(k,d){
  const n=OL.players.length||4;
  const nv=Math.max(0,(G.roles[k]||0)+d);
  if(k==='mafia'&&nv<1)return;
  if(k==='doctor'&&nv>1){toast('مسموح بطبيب واحد فقط');return;}
  G.roles[k]=nv;
  const specials=Object.keys(G.roles).filter(k=>k!=='mafia').reduce((s,k)=>s+(G.roles[k]||0),0);
  const civ=n-G.roles.mafia-specials;
  if(civ<0){G.roles[k]=Math.max(0,G.roles[k]-d);toast('لا يكفي اللاعبين!');return;}
  document.getElementById(`orv-${k}`).textContent=G.roles[k];
  const cnt=document.getElementById(`civ-cnt`);if(cnt)cnt.textContent=Math.max(0,civ);
};

window.togSetting=function(key){
  G.s[key]=!G.s[key];
  const ids={showMafia:'tog-online-maf',revealDead:'tog-online-revealdead',sounds:'tog-online-snd'};
  if(ids[key])document.getElementById(ids[key])?.classList.toggle('on',G.s[key]);
};

// ─────────────────────────────────────────────
//  CHAT HELPERS
// ─────────────────────────────────────────────
window.showJoinInput=function(){
  const w=document.getElementById('join-input-wrap');
  w.style.display=w.style.display==='none'?'block':'none';
  OL.loadRooms();
};

window.toggleChat=function(){
  const ui=document.getElementById('chat-ui');
  const badge=document.getElementById('chat-badge');
  ui.classList.toggle('open');
  badge.classList.remove('show');
  badge.textContent='0';
  if(ui.classList.contains('open'))document.getElementById('chat-inp').focus();
};

window.setChat=function(type){
  OL.chatType=type;
  document.querySelectorAll('.chat-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('tab-'+type).classList.add('active');
};

window.sendChatMsg=function(){
  OL.sendMsg(OL.chatType||'global');
};

// ─────────────────────────────────────────────
//  DAY ONLINE HELPERS
// ─────────────────────────────────────────────
window.execVoteAction=function(){
  if(OL.roomId)OL.execOnlineVote();
  else G.execVote();
};
window.skipExecAction=function(){
  if(OL.roomId)OL.endDayOnline();
  else G.skipExec();
};
window.endDayAction=function(){
  if(OL.roomId)OL.endDayOnline();
  else G.endDay();
};
window.startDayAction=function(){
  if(OL.roomId)OL.startDay();
  else G.startDay();
};
window.restartAction=function(){
  if(OL.roomId)OL.restartOnline();
  else G.showSetup();
};
window.closeDet=function(){
  document.getElementById('m-det').classList.remove('show');
  if(window._detCallback){window._detCallback();window._detCallback=null;}
  else G.advanceNight();
};

// Load rooms when online menu opens
document.getElementById('s-online-menu').addEventListener('animationstart',()=>OL.loadRooms());

// ─────────────────────────────────────────────
//  LOCAL GAME ENGINE (G)
// ─────────────────────────────────────────────
window.G={
  s:{sounds:true,showMafia:false,oneVote:true,discTime:0,voteTime:0,nightTime:20,revealDead:true,showAdv:false},
  players:[],
  roles:{mafia:1,godfather:0,doctor:0,detective:0,sniper:0,bodyguard:0,jester:0,blackmailer:0,mayor:0,witch:0,serialKiller:0},
  round:1,phase:'setup',myIdx:0,currentChat:'global',chatOpen:false,
  revealIdx:0,nQueue:[],nQIdx:0,nActs:{},nSelected:null,
  docSelfUsed:false,sniperFired:false,silencedIdx:null,witchUsed:false,
  votes:{},votedBy:{},voteQueue:[],vQIdx:0,timerInt:null,timerLeft:0,

  sc(id){showScreen(id);},
  alive(){return this.players.filter(p=>p.alive);},
  mafCnt(){return this.players.filter(p=>p.alive&&(p.role==='mafia'||p.role==='godfather')).length;},
  civCnt(){return this.players.filter(p=>p.alive&&p.role!=='mafia'&&p.role!=='godfather').length;},
  specials(){return Object.keys(this.roles).filter(k=>k!=='mafia').reduce((s,k)=>s+(this.roles[k]||0),0);},

  showRules(){
    document.getElementById('rules-content').innerHTML=`
      <div class="card"><div style="font-weight:900;font-size:1.05rem;margin-bottom:9px">🎭 كيف تُلعب؟</div>
        <div class="muted" style="line-height:1.85">اللعبة تتناوب بين <strong style="color:var(--text)">الليل</strong> و<strong style="color:var(--text)">النهار</strong>.<br>
        — في الليل: كل دور ينفذ خاصيته سراً.<br>— في النهار: يتناقش الجميع ويصوتون على إعدام مشتبه به.</div>
      </div>
      ${Object.entries(RD).map(([k,r])=>`<div class="card" style="border-color:${r.col}33;margin-bottom:9px">
        <div style="display:flex;align-items:center;gap:9px;margin-bottom:6px">
          <span style="font-size:1.4rem">${r.ic}</span>
          <span style="font-weight:900;color:${r.col}">${r.n}</span>
          <span class="badge" style="background:${r.col}20;color:${r.col};margin-right:auto">${r.team}</span>
        </div>
        <div class="muted" style="font-size:.84rem;line-height:1.7">${r.d}</div>
      </div>`).join('')}
      <div class="card"><div style="font-weight:900;margin-bottom:9px">⚖️ شرط الفوز</div>
        <div style="background:var(--surface2);border:1px solid var(--mafia);border-radius:10px;padding:10px;font-size:.86rem;margin-bottom:8px">🔴 <strong>المافيا تفوز</strong> عندما يساوي عددهم عدد المدنيين أو يتجاوزه</div>
        <div style="background:var(--surface2);border:1px solid var(--civil);border-radius:10px;padding:10px;font-size:.86rem">🔵 <strong>المدنيون يفوزون</strong> بالقضاء على كل أفراد المافيا</div>
      </div>`;
    showScreen('s-rules');
  },

  showSetup(){
    this.players=[];
    this.roles={mafia:1,godfather:0,doctor:0,detective:0,sniper:0,bodyguard:0,jester:0,blackmailer:0,mayor:0,witch:0,serialKiller:0};
    this.s={sounds:true,showMafia:false,oneVote:true,discTime:0,voteTime:0,nightTime:20,revealDead:true,showAdv:false};
    this.round=1;this.phase='setup';this.revealIdx=0;this.nQueue=[];this.nQIdx=0;this.nActs={};
    this.votes={};this.votedBy={};this.voteQueue=[];this.vQIdx=0;
    this.docSelfUsed=false;this.sniperFired=false;this.nSelected=null;
    ['tog-snd','tog-onevote','tog-revealdead'].forEach(id=>{const el=document.getElementById(id);if(el)el.classList.add('on');});
    const maf=document.getElementById('tog-maf');if(maf)maf.classList.remove('on');
    this.renderPList();this.renderRGrid();this.updatePMsg();
    showScreen('s-setup');
  },

  renderPList(){
    const el=document.getElementById('plist');if(!el)return;
    if(!this.players.length){el.innerHTML='<div class="muted tc" style="padding:10px 0">لا يوجد لاعبون بعد...</div>';return;}
    el.innerHTML=this.players.map((p,i)=>`<div class="p-item">
      <div class="p-ava ${ava(i)}">${p.name[0].toUpperCase()}</div>
      <div class="p-name">${p.name}</div>
      <button class="p-del" onclick="G.removeP(${i})">✕</button>
    </div>`).join('');
  },

  addP(){
    const inp=document.getElementById('pinp');
    const nm=inp.value.trim();
    if(!nm){toast('أدخل اسم اللاعب!');return;}
    if(this.players.find(p=>p.name===nm)){toast('الاسم موجود مسبقاً!');return;}
    if(this.players.length>=12){toast('الحد الأقصى 12 لاعباً');return;}
    this.players.push({name:nm,role:'',alive:true,protected:false});
    inp.value='';inp.focus();
    this.renderPList();this.updatePMsg();this.autoRoles();snd('click');
  },

  removeP(i){this.players.splice(i,1);this.renderPList();this.updatePMsg();this.autoRoles();},

  updatePMsg(){
    const el=document.getElementById('pcnt-msg'),n=this.players.length;if(!el)return;
    if(n<4)el.innerHTML=`<span style="color:var(--mafia)">${n} لاعبين — يلزم 4 على الأقل</span>`;
    else el.innerHTML=`<span style="color:var(--doctor)">${n} لاعبين ✓</span>`;
  },

  autoRoles(){
    const n=this.players.length;
    if(n<=4)this.roles.mafia=1;
    else if(n>=8&&this.roles.mafia<2)this.roles.mafia=2;
    this.renderRGrid();
  },

  renderRGrid(){
    const el=document.getElementById('rgrid');if(!el)return;
    const main=['mafia','doctor','detective','sniper'];
    const advanced=['godfather','blackmailer','bodyguard','mayor','witch','jester','serialKiller'];
    const toShow=this.s.showAdv?[...main,...advanced]:main;
    el.innerHTML=toShow.map(k=>{
      const r=RD[k],c=this.roles[k]||0,on=c>0;
      return `<div class="rcrd ${on?'on':''}" style="${on?'--rc:'+r.col+';--rg:'+r.gl:''}">
        ${on?`<div class="rcrd-cnt" style="background:${r.col}">${c}</div>`:''}
        <div class="rcrd-icon">${r.ic}</div>
        <div class="rcrd-name" style="${on?'color:'+r.col:''}">${r.n}</div>
        <div class="ccrow">
          <div class="ccbtn" onclick="G.adjRole('${k}',-1)">−</div>
          <div class="ccval">${c}</div>
          <div class="ccbtn" onclick="G.adjRole('${k}',1)">+</div>
        </div>
      </div>`;
    }).join('');
    const civ=Math.max(0,this.players.length-this.roles.mafia-this.specials());
    el.innerHTML+=`<div class="rcrd on" style="--rc:var(--civil);--rg:var(--civil-g);grid-column:1/-1;border-color:var(--civil);flex-direction:row;gap:10px;display:flex;align-items:center;padding:12px 14px">
      <div class="rcrd-cnt" style="background:var(--civil);position:static;margin:0">${civ}</div>
      <span style="font-size:1.3rem">🔵</span>
      <span class="rcrd-name" style="color:var(--civil);font-size:.85rem">مدنيون — محسوبون تلقائياً</span>
    </div>
    <button class="btn btn-ghost btn-sm" style="grid-column:1/-1;margin-top:10px" onclick="G.togAdv()">
      ${this.s.showAdv?'⬆️ إخفاء الأدوار الإضافية':'⚙️ أدوار إضافية'}
    </button>`;
    const rw=document.getElementById('rwarning');if(rw)rw.textContent=civ<0?'⚠️ عدد الأدوار يتجاوز عدد اللاعبين!':'';
  },

  adjRole(k,d){
    const n=this.players.length;const nv=Math.max(0,(this.roles[k]||0)+d);
    if(k==='doctor'&&nv>1){toast('مسموح بطبيب واحد فقط');return;}
    if(k==='mafia'&&nv<1)return;
    if(k==='mafia'&&n<=4&&nv>1){toast('مع 4 لاعبين: مافيا واحد فقط!');return;}
    const old=this.roles[k];this.roles[k]=nv;
    const civ=n-this.roles.mafia-this.specials();
    if(civ<0){this.roles[k]=old;toast('لا يكفي اللاعبين لهذا العدد!');return;}
    this.renderRGrid();snd('click');
  },

  togAdv(){this.s.showAdv=!this.s.showAdv;this.renderRGrid();snd('click');},

  pill(el,type){
    const cont=document.getElementById(`${type}-pills`);
    cont.querySelectorAll('.pill').forEach(p=>p.classList.remove('on'));
    el.classList.add('on');
    const v=parseInt(el.dataset.v);
    const custId=type+'-custom';
    const custEl=document.getElementById(custId);if(custEl)custEl.style.display=v===-1?'block':'none';
    const key=type.includes('disc')?'discTime':'voteTime';
    if(v!==-1)this.s[key]=v;
    snd('click');
  },

  tog(k){
    const map={snd:'sounds',maf:'showMafia',onevote:'oneVote',revealdead:'revealDead'};
    this.s[map[k]]=!this.s[map[k]];
    document.getElementById('tog-'+k)?.classList.toggle('on',this.s[map[k]]);
    snd('click');
  },

  start(){
    const n=this.players.length;if(n<4){toast('تحتاج 4 لاعبين!');return;}
    const civ=n-this.roles.mafia-this.specials();if(civ<0){toast('عدد الأدوار لا يناسب اللاعبين!');return;}
    this.s.nightTime=parseInt(document.getElementById('night-sec')?.value)||30;
    let pool=[];
    ['mafia','godfather','doctor','bodyguard','detective','sniper','jester','blackmailer','mayor','witch','serialKiller'].forEach(k=>{for(let i=0;i<(this.roles[k]||0);i++)pool.push(k);});
    while(pool.length<n)pool.push('civil');
    for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}
    for(let i=this.players.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[this.players[i],this.players[j]]=[this.players[j],this.players[i]];}
    this.players.forEach((p,i)=>{p.role=pool[i];p.alive=true;p.protected=false;p.idx=i;});
    this.revealIdx=0;
    this.showPass(this.players[0].name,'🎭','مرّر الهاتف!',`اللاعب: <strong>${this.players[0].name}</strong><br><small style="color:var(--muted)">لا تُظهر الشاشة لأحد</small>`,'👁 اضغط للاطلاع على دورك',()=>this.revealRole());
  },

  showPass(nm,ico,ttl,sub,btnTxt,cb){
    document.getElementById('pass-ico').textContent=ico;
    document.getElementById('pass-ttl').textContent=ttl;
    document.getElementById('pass-sub').innerHTML=sub;
    const b=document.getElementById('pass-btn');b.textContent=btnTxt;b.onclick=cb;
    showScreen('s-pass');
  },

  revealRole(){
    const p=this.players[this.revealIdx];const r=RD[p.role];
    const card=document.getElementById('big-card');
    card.style.setProperty('--rc',r.col);card.style.setProperty('--rg',r.gl);
    const bt=document.getElementById('big-team');bt.textContent=r.team;bt.style.background=r.col+'20';bt.style.color=r.col;bt.style.borderColor=r.col+'40';
    document.getElementById('big-icon').textContent=r.ic;
    document.getElementById('big-name').textContent=r.n;document.getElementById('big-name').style.color=r.col;
    document.getElementById('big-img').style.backgroundImage=`url('${r.img}')`;
    let desc=r.d;
    if(p.role==='mafia'||p.role==='godfather'){
      const tm=this.players.filter(x=>(x.role==='mafia'||x.role==='godfather')&&x.name!==p.name).map(x=>x.name);
      if(tm.length)desc+=` | 👥 زملاؤك: ${tm.join('، ')}`;
    }
    document.getElementById('big-desc').textContent=desc;
    document.getElementById('reveal-who').textContent=p.name;
    document.getElementById('tap-ov').classList.remove('gone');
    document.getElementById('role-next').style.display='none';
    showScreen('s-role');
  },

  tapReveal(){
    document.getElementById('tap-ov').classList.add('gone');
    document.getElementById('role-next').style.display='flex';
    snd('click');
  },

  nextReveal(){
    this.revealIdx++;
    if(this.revealIdx>=this.players.length){this.startNight();return;}
    const p=this.players[this.revealIdx];
    this.showPass(p.name,'📱','مرّر الهاتف!',`اللاعب: <strong>${p.name}</strong><br><small style="color:var(--muted)">لا تُظهر الشاشة لأحد</small>`,'👁 اضغط للاطلاع على دورك',()=>this.revealRole());
  },

  startNight(){
    if(this.checkWin())return;
    this.phase='night';this.nActs={};this.nSelected=null;
    this.nQueue=this.players.map((_,i)=>i);this.nQIdx=0;
    document.getElementById('n-rnd').textContent=this.round;
    document.getElementById('n-alive').textContent=`${this.alive().length} أحياء`;
    if(!this.nQueue.length){this.processNight();return;}
    this.nightStep();
  },

  nightStep(){
    if(this.nQIdx>=this.nQueue.length){this.processNight();return;}
    const pIdx=this.nQueue[this.nQIdx];const pl=this.players[pIdx];
    if(!pl.alive){this.nQIdx++;this.nightStep();return;}
    this.showPass(pl.name,'🌙','دور الليل',`اللاعب: <strong>${pl.name}</strong><br><small style="color:var(--muted)">استلم الهاتف بخصوصية</small>`,'بدء الدور',()=>this.showNightAction(pl.role));
  },

  showNightAction(role){
    const hasAction=['mafia','godfather','doctor','detective','sniper','bodyguard','blackmailer','witch','serialKiller'].includes(role);
    const r=RD[role]||RD.civil;
    document.getElementById('n-emo').textContent=r.ic;
    document.getElementById('n-rlbl').textContent=r.n;
    if(!hasAction||(role==='sniper'&&this.sniperFired)){
      document.getElementById('n-hint').textContent='أنت نائم الآن... انتظر';
      document.getElementById('pick-grid').innerHTML='<div class="muted tc" style="grid-column:1/-1;padding:40px">لا يوجد إجراء لك هذه الليلة</div>';
    } else {
      const hints={mafia:'اختر ضحيتك الليلة',godfather:'اختر ضحيتك الليلة',doctor:'من تنقذ الليلة؟',detective:'من تحقق في هويته؟',sniper:'استخدم رصاصتك الآن!',blackmailer:'اختر لاعباً لإسكاته غداً',witch:'اختر هدفك',serialKiller:'اختر ضحيتك!'};
      let hint=hints[role]||'';
      if((role==='mafia'||role==='godfather')&&this.nActs['mafia']!==undefined){
        hint+=` | 🔴 زميلك اختار: ${this.players[this.nActs['mafia']]?.name}`;
      }
      document.getElementById('n-hint').textContent=hint;
      document.getElementById('sniper-warn').style.display=role==='sniper'?'block':'none';
      this.nSelected=null;this.renderPickGrid(role);
    }
    this.nSelected=null;document.getElementById('n-confirm').style.display='none';
    this.startTimer(this.s.nightTime,'n-tbar','n-ttxt','n-tbar-wrap',()=>{if(this.nSelected===null)this.nightSkip();else this.nightConfirm();});
    showScreen('s-night');
  },

  renderPickGrid(role){
    const r=RD[role];
    const mafias=this.players.filter(p=>p.role==='mafia'||p.role==='godfather').map(p=>p.idx);
    const myIdx=this.players.findIndex(p=>p.alive&&p.role===role);
    document.getElementById('pick-grid').innerHTML=this.alive().map(p=>{
      const pi=this.players.indexOf(p);
      let disabled=false;
      if(role==='doctor'&&pi===myIdx&&this.docSelfUsed)disabled=true;
      if(['mafia','godfather','blackmailer'].includes(role)&&(p.role==='mafia'||p.role==='godfather'||p.role==='blackmailer'))disabled=true;
      return `<div class="pick-card ${disabled?'dead':''}" id="pc-${pi}" style="--rc:${r.col};--rg:${r.gl}" onclick="G.pickN(${pi})">
        <div class="pick-tick">✓</div>
        <div class="pick-ava ${ava(pi)}">${p.name[0].toUpperCase()}</div>
        <div class="pick-nm">${p.name}</div>
        ${(['mafia','godfather'].includes(role)&&mafias.includes(pi))?'<div class="mafia-team-badge">مافيا</div>':''}
        ${disabled?'<div style="font-size:.68rem;color:var(--muted);margin-top:3px">لا يمكن</div>':''}
      </div>`;
    }).join('');
  },

  pickN(idx){
    document.querySelectorAll('#pick-grid .pick-card').forEach(c=>c.classList.remove('on'));
    document.getElementById('pc-'+idx)?.classList.add('on');
    this.nSelected=idx;document.getElementById('n-confirm').style.display='flex';snd('click');
  },

  nightConfirm(){
    const pIdx=this.nQueue[this.nQIdx];const role=this.players[pIdx].role;
    if(this.nSelected===null){toast('اختر لاعباً أولاً!');return;}
    const actRole=(role==='godfather')?'mafia':role;
    this.nActs[actRole]=this.nSelected;
    if(role==='detective'){
      const t=this.players[this.nSelected];const isMaf=(t.role==='mafia');
      document.getElementById('det-res').innerHTML=`<div style="font-size:2.8rem;margin-bottom:10px">${isMaf?'🔴':'🟢'}</div>
        <div style="font-size:1.05rem;font-weight:900;margin-bottom:5px">${t.name}</div>
        <div style="font-size:.95rem;color:${isMaf?'var(--mafia)':'var(--doctor)'};font-weight:700">${isMaf?'⚠️ هذا الشخص مافيا!':'✅ هذا الشخص بريء'}</div>`;
      document.getElementById('m-det').classList.add('show');
      return;
    }
    this.advanceNight();
  },

  nightSkip(){this.nSelected=null;this.advanceNight();},

  advanceNight(){
    this.nSelected=null;this.nQIdx++;this.stopTimer();
    if(this.nQIdx>=this.nQueue.length){this.processNight();return;}
    this.nightStep();
  },

  processNight(){
    const results=[];const overlay=document.getElementById('night-overlay');
    this.players.forEach(p=>p.protected=false);
    const docT=this.nActs['doctor'];if(docT!==undefined){this.players[docT].protected=true;const di=this.players.findIndex(p=>p.role==='doctor');if(docT===di)this.docSelfUsed=true;}
    const bgT=this.nActs['bodyguard'];if(bgT!==undefined)this.players[bgT].protected=true;
    const mafT=this.nActs['mafia'];
    if(mafT!==undefined){
      const t=this.players[mafT];
      if(t.protected){results.push({type:'protected',name:t.name});snd('protect');overlay.className='night-anim-protect';}
      else{t.alive=false;results.push({type:'killed',name:t.name,role:t.role});snd('kill');overlay.className='night-anim-kill';}
    } else {results.push({type:'safe'});}
    const snpT=this.nActs['sniper'];
    if(snpT!==undefined&&!this.sniperFired){
      this.sniperFired=true;const t=this.players[snpT];const snp=this.players.find(p=>p.role==='sniper');
      if(t.role==='mafia'||t.role==='godfather'){t.alive=false;results.push({type:'sniper-hit',name:t.name});snd('kill');}
      else{if(snp)snp.alive=false;results.push({type:'sniper-miss',tName:t.name,sName:snp?.name});snd('kill');}
    }
    this.silencedIdx=this.nActs['blackmailer']!==undefined?this.nActs['blackmailer']:null;
    const skT=this.nActs['serialKiller'];if(skT!==undefined){const t=this.players[skT];if(!t.protected){t.alive=false;results.push({type:'killed',name:t.name,role:t.role});snd('kill');}}
    setTimeout(()=>{overlay.className='';this.renderNightResult(results);},1000);
    this.checkWin();
  },

  renderNightResult(res){
    const el=document.getElementById('nres-content');
    const cards=res.map(r=>{
      if(r.type==='killed')return `<div class="nr-card" style="border-color:var(--mafia);background:#e6394410"><div class="nr-icon">💀</div><div class="nr-title" style="color:var(--mafia)">${r.name} تم قتله الليلة!</div>${G.s?.revealDead?`<div class="nr-sub">كان دوره: ${RD[r.role]?.n||r.role}</div>`:'<div class="nr-sub">الدور مخفي</div>'}</div>`;
      if(r.type==='protected')return `<div class="nr-card" style="border-color:var(--doctor);background:#2dc65310"><div class="nr-icon">🛡️</div><div class="nr-title" style="color:var(--doctor)">${r.name} نجا من الموت!</div></div>`;
      if(r.type==='safe')return `<div class="nr-card" style="border-color:var(--civil);background:#4cc9f010"><div class="nr-icon">🌙</div><div class="nr-title" style="color:var(--civil)">ليلة هادئة</div><div class="nr-sub">لم يُقتل أحد هذه الليلة</div></div>`;
      if(r.type==='sniper-hit')return `<div class="nr-card" style="border-color:var(--sniper);background:#9d4edd10"><div class="nr-icon">🎯</div><div class="nr-title" style="color:var(--sniper)">القناص أصاب هدفه!</div><div class="nr-sub">${r.name} كان مافيا</div></div>`;
      if(r.type==='sniper-miss')return `<div class="nr-card" style="border-color:var(--mafia);background:#e6394410"><div class="nr-icon">💥</div><div class="nr-title" style="color:var(--mafia)">القناص أخطأ!</div><div class="nr-sub">${r.sName} أُعدم — أصاب بريئاً (${r.tName})</div></div>`;
      return '';
    }).join('');
    const alive=this.players.filter(p=>p.alive);
    const mc=alive.filter(p=>p.role==='mafia'||p.role==='godfather').length;
    const cc=alive.filter(p=>p.role!=='mafia'&&p.role!=='godfather').length;
    el.innerHTML=`<div class="stat-row">
      <div class="stat-b"><div class="stat-n">${alive.length}</div><div class="stat-l">أحياء</div></div>
      <div class="stat-b"><div class="stat-n" style="color:var(--mafia)">${mc}</div><div class="stat-l">مافيا</div></div>
      <div class="stat-b"><div class="stat-n" style="color:var(--civil)">${cc}</div><div class="stat-l">مدنيون</div></div>
    </div>${cards}`;
    if(this.phase!=='result')showScreen('s-nresult');
  },

  startDay(){
    if(this.checkWin())return;
    this.phase='day';this.votes={};this.votedBy={};
    if(this.silencedIdx!==null)toast(`🤫 ${this.players[this.silencedIdx].name} مُسكت!`);
    this.voteQueue=this.alive().map(p=>this.players.indexOf(p));this.vQIdx=0;
    document.getElementById('d-rnd').textContent=this.round;
    document.getElementById('d-alive').textContent=`${this.alive().length} أحياء`;
    document.getElementById('disc-msg').style.display='block';
    document.getElementById('exec-btn').style.display='none';
    document.getElementById('start-vote-btn').style.display='block';
    document.getElementById('skip-turn-btn').style.display='none';
    if(this.s.discTime>0)this.startTimer(this.s.discTime,'tbar','ttxt','tbar-wrap',()=>toast('انتهى وقت النقاش!'));
    this.renderDayList();
    showScreen('s-day');
  },

  renderDayList(){
    const el=document.getElementById('day-list');
    el.innerHTML=this.players.map((p,i)=>{
      if(!p.alive)return `<div class="day-row dead"><div class="p-ava ${ava(i)}">${p.name[0].toUpperCase()}</div><div style="flex:1"><div class="bold" style="font-size:.9rem">${p.name}</div><div style="font-size:.72rem;color:var(--muted)">💀 مات</div></div></div>`;
      const vc=this.votes[i]||0;const voted=Object.values(this.votedBy).includes(i);
      return `<div class="day-row ${voted?'hi':''}" id="dr-${i}">
        <div class="p-ava ${ava(i)}">${p.name[0].toUpperCase()}</div>
        <div style="flex:1"><div class="bold" style="font-size:.9rem">${p.name}</div></div>
        <div class="vcnt ${vc>0?'vv':''}" id="vc-${i}">${vc||''}</div>
        <button class="vbtn ${voted?'on':''}" id="vb-${i}" onclick="G.castVote(${i})">${voted?'✓ صوّت':' صوّت'}</button>
      </div>`;
    }).join('');
    this.updateExecBtn();this.updateVoteProgress();
    const skBtn=document.getElementById('skip-turn-btn');
    if(skBtn)skBtn.style.display=(this.s.oneVote&&this.vQIdx<this.voteQueue.length)?'flex':'none';
  },

  renderDayOnline(d){
    // For online, all players vote on their own device
    const el=document.getElementById('day-list');
    const players=this.players;
    const votes=d.votes||{};
    const myVote=votes[OL.myName];
    document.getElementById('d-rnd').textContent=d.round||1;
    document.getElementById('d-alive').textContent=`${players.filter(p=>p.alive).length} أحياء`;
    document.getElementById('start-vote-btn').style.display='none';
    if(OL.isHost){
      document.getElementById('exec-btn').style.display='flex';
    }
    el.innerHTML=players.map((p,i)=>{
      if(!p.alive)return `<div class="day-row dead"><div class="p-ava ${ava(i)}">${p.name[0].toUpperCase()}</div><div style="flex:1"><div class="bold" style="font-size:.9rem">${p.name}</div><div style="font-size:.72rem;color:var(--muted)">💀 مات</div></div></div>`;
      const voted=Object.values(votes).includes(p.name);
      const vc=Object.values(votes).filter(v=>v===p.name).length;
      const iMine=myVote===p.name;
      const me=players.find(x=>x.name===OL.myName);
      const isAlive=me&&me.alive;
      return `<div class="day-row ${voted?'hi':''}" id="dr-${i}">
        <div class="p-ava ${ava(i)}">${p.name[0].toUpperCase()}</div>
        <div style="flex:1"><div class="bold" style="font-size:.9rem">${p.name}</div></div>
        <div class="vcnt ${vc>0?'vv':''}">${vc||''}</div>
        ${isAlive?`<button class="vbtn ${iMine?'on':''}" onclick="OL.submitVote('${p.name}')">${iMine?'✓ صوّتُ لـه':'صوّت'}</button>`:''}
      </div>`;
    }).join('');
  },

  castVote(ti){
    if(!this.players[ti]?.alive)return;
    const voterIdx=this.s.oneVote?this.voteQueue[this.vQIdx]:0;
    if(this.s.oneVote&&this.vQIdx>=this.voteQueue.length){toast('جميع اللاعبين صوّتوا!');return;}
    if(this.s.oneVote&&voterIdx===this.silencedIdx){toast('أنت مُسكت!');this.vQIdx++;this.advanceVoting();return;}
    const prevTarget=this.votedBy[voterIdx];
    if(prevTarget===ti){this.votes[ti]=Math.max(0,(this.votes[ti]||0)-1);delete this.votedBy[voterIdx];}
    else{
      if(prevTarget!==undefined)this.votes[prevTarget]=Math.max(0,(this.votes[prevTarget]||0)-1);
      const weight=(this.players[voterIdx].role==='mayor')?2:1;
      this.votes[ti]=(this.votes[ti]||0)+weight;this.votedBy[voterIdx]=ti;
    }
    this.renderDayList();snd('click');
    if(this.s.oneVote&&this.votedBy[voterIdx]!==undefined){this.vQIdx++;this.advanceVoting();}
  },

  skipVoteTurn(){
    if(!this.s.oneVote||this.vQIdx>=this.voteQueue.length)return;
    toast('تم تخطي صوتك');this.vQIdx++;this.advanceVoting();snd('click');
  },

  advanceVoting(){
    if(this.vQIdx<this.voteQueue.length){
      setTimeout(()=>{
        const nextPi=this.voteQueue[this.vQIdx];const np=this.players[nextPi];
        this.renderDayList();this.showVotePass(np.name,nextPi);
      },400);
    } else {
      this.renderDayList();toast('انتهى التصويت!');
      document.getElementById('exec-btn').style.display='flex';
      document.getElementById('skip-turn-btn').style.display='none';
    }
  },

  showVotePass(nm){
    document.getElementById('vpass-nm').textContent=nm;
    document.getElementById('vpass-btn').onclick=()=>showScreen('s-day');
    showScreen('s-vpass');
  },

  startVoting(){
    this.stopTimer();
    document.getElementById('disc-msg').style.display='none';
    document.getElementById('start-vote-btn').style.display='none';
    this.voteQueue=this.alive().map(p=>this.players.indexOf(p));this.vQIdx=0;
    this.votes={};this.votedBy={};
    if(this.s.voteTime>0)this.startTimer(this.s.voteTime,'tbar','ttxt','tbar-wrap',()=>{toast('انتهى وقت التصويت!');document.getElementById('exec-btn').style.display='flex';});
    if(this.s.oneVote&&this.voteQueue.length>0){
      const fp=this.players[this.voteQueue[0]];this.renderDayList();this.showVotePass(fp.name,0);
    } else {this.renderDayList();}
  },

  updateExecBtn(){
    const mv=Math.max(0,...Object.values(this.votes).filter(v=>v>0),0);
    if(!this.s.oneVote)document.getElementById('exec-btn').style.display=mv>0?'flex':'none';
  },

  updateVoteProgress(){
    const el=document.getElementById('vote-progress');if(!this.s.oneVote){el.textContent='';return;}
    const total=this.voteQueue.length,done=this.vQIdx;
    el.textContent=done<total?`صوّت ${done} من ${total} لاعبين`:`تم تجميع ${total} صوت ✓`;
  },

  execVote(){
    this.stopTimer();
    const vs=Object.entries(this.votes).filter(([,v])=>v>0);
    if(!vs.length){toast('لا أصوات!');return;}
    const mx=Math.max(...vs.map(([,v])=>v));const cands=vs.filter(([,v])=>v===mx).map(([i])=>parseInt(i));
    if(cands.length>1){toast('تعادل! عفو عام');setTimeout(()=>this.endDayRound(),1200);return;}
    const idx=cands[0];const p=this.players[idx];
    if(p.role==='jester'){this.showResult('jester');return;}
    p.alive=false;snd('vote-kill');
    const roleReveal=this.s.revealDead?` (${RD[p.role]?.n})`:'';
    toast(`⚖️ تم إعدام ${p.name}!${roleReveal}`);
    if(!this.checkWin())setTimeout(()=>this.endDayRound(),1800);
  },

  skipExec(){this.stopTimer();toast('🕊️ عفو عام');setTimeout(()=>this.endDayRound(),900);},
  endDay(){this.stopTimer();this.endDayRound();},
  endDayRound(){if(this.checkWin())return;this.round++;this.startNight();},

  checkWin(){
    const mc=this.mafCnt(),cc=this.civCnt();
    const sk=this.players.find(p=>p.alive&&p.role==='serialKiller');
    if(sk&&this.alive().length<=2){this.showResult('serialKiller');return true;}
    if(mc===0){this.showResult('civil');return true;}
    if(mc>=cc){this.showResult('mafia');return true;}
    return false;
  },

  showResult(winner){
    this.stopTimer();this.phase='result';snd(winner==='civil'?'win':'kill');
    const ico=document.getElementById('res-ico'),ttl=document.getElementById('res-ttl'),sub=document.getElementById('res-sub');
    const msgs={mafia:{i:'🔴',t:'المافيا تفوز!',s:'نجحت المافيا في السيطرة على المدينة 😈',c:'var(--mafia)'},civil:{i:'🏆',t:'المدنيون يفوزون!',s:'تم القضاء على كل المافيا! 🎉',c:'var(--civil)'},jester:{i:'🤡',t:'المهرج فاز!',s:'لقد خدعكم المهرج وجعلكم تعدمونه!',c:'#ff006e'},serialKiller:{i:'🔪',t:'القاتل فاز!',s:'لقد قضى القاتل المتسلسل على الجميع وبقي وحيداً.',c:'#f72585'}};
    const m=msgs[winner]||msgs.civil;
    ico.textContent=m.i;ttl.textContent=m.t;ttl.style.color=m.c;sub.textContent=m.s;
    document.getElementById('rrl').innerHTML=`<div style="font-weight:900;margin-bottom:10px;font-size:.95rem">🎭 الكشف عن الأدوار</div>
      ${this.players.map((p,i)=>`<div class="rrl-row">
        <span style="font-size:1.1rem">${RD[p.role]?.ic||'?'}</span>
        <span style="flex:1;font-weight:${p.alive?700:400};color:${p.alive?'var(--text)':'var(--muted)'};font-size:.88rem">${p.name}</span>
        <span style="font-size:.78rem;color:${RD[p.role]?.col||'var(--muted)'};font-weight:700">${RD[p.role]?.n||''}</span>
        ${!p.alive?'<span style="font-size:.75rem;margin-right:4px">💀</span>':''}
      </div>`).join('')}`;
    // Show restart for online host
    if(OL.roomId){
      document.getElementById('restart-btn').textContent=OL.isHost?'🔄 العب مرة أخرى (أدوار جديدة)':'⏳ انتظر الهوست للبدء مجدداً';
      document.getElementById('restart-btn').disabled=!OL.isHost;
    }
    showScreen('s-result');
  },

  startTimer(sec,fillId,txtId,wrapId,onEnd){
    const wrap=document.getElementById(wrapId),fill=document.getElementById(fillId),txt=document.getElementById(txtId);
    if(wrap)wrap.style.display='block';if(txt)txt.style.display='block';
    this.timerLeft=sec;clearInterval(this.timerInt);
    const upd=()=>{
      if(!fill||!txt)return;
      fill.style.width=Math.max(0,(this.timerLeft/sec)*100)+'%';
      const m=Math.floor(this.timerLeft/60),s=this.timerLeft%60;
      txt.textContent=`⏱ ${m}:${String(s).padStart(2,'0')}`;
      if(this.timerLeft<=0){clearInterval(this.timerInt);txt.style.color='var(--mafia)';if(onEnd)onEnd();return;}
      this.timerLeft--;
    };
    upd();this.timerInt=setInterval(upd,1000);
  },

  stopTimer(){
    clearInterval(this.timerInt);
    ['tbar-wrap','ttxt','n-tbar-wrap','n-ttxt','on-tbar-wrap','on-ttxt'].forEach(id=>{
      const el=document.getElementById(id);if(el){el.style.display='none';if(id.includes('ttxt'))el.style.color='';}
    });
  },
};
</script>
</body>
</html>
